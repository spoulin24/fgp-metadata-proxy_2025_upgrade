			<abstract xsi:type="gmd:PT_FreeText_PropertyType">
				<gco:CharacterString>A grid of cells 1 km by 1 km covering the areas of New Brunswick where lidar data has been collected. Each grid cell includes a link to download lidar data.</gco:CharacterString>
				<PT_FreeText>
					<textGroup>
						<LocalisedCharacterString locale="#fra">Une grille de cellules de 1 km2 couvrant les zones du Nouveau-Brunswick où des données Lidar ont été recueillies. Chaque cellule de la grille contient un lien permettant de télécharger des données Lidar.</LocalisedCharacterString>
					</textGroup>
				</PT_FreeText>
			</abstract>
