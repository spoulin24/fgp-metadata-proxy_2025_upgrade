DEFAULT_MACRO RESULTAT_JSON $(FME_MF_DIR)ETALON_DATA\PT_Harvester\BC\JSON_LOCAL\00a498df-f449-461d-a45e-c6e08a3df6a3.json
GUI OPTIONAL FILENAME_EXISTING RESULTAT_JSON | RESULTAT_JSON:
DEFAULT_MACRO KEYS_TO_IGNORE 
GUI OPTIONAL TEXT KEYS_TO_IGNORE KEYS_TO_IGNORE, list, comma-separated, like : metadata_modified, datetime, ...:
#! START_HEADER
