Tcl2 set ListConcatenator_2__separator [FME_DecodeText {|}];      regsub -all \"{}\" [FME_DecodeText {_values<opencurly><closecurly>._list_value}] [FME_DecodeText {<opencurly><backslash>d+<closecurly>}] ListConcatenator_2__listPattern;      set ListConcatenator_2__listPattern ^$ListConcatenator_2__listPattern$;
Tcl2 proc ListConcatenator_2__Concatenate {} {   upvar \#0 ListConcatenator_2__separator separator             ListConcatenator_2__listPattern listPattern;   set allAttrs [lsort -dictionary [FME_AttributeNames]];   set keepEmptyParts [string equal {No} {No}];   set result {};   foreach attrName $allAttrs {     if {[regexp $listPattern $attrName]} {       set attrValue [FME_GetAttribute $attrName];       if {$keepEmptyParts || $attrValue != {}} {         lappend result $attrValue;       };     };   };   FME_SetAttribute {"final_value"} [join $result $separator]; }
FACTORY_DEF * TeeFactory    FACTORY_NAME ListConcatenator_2    INPUT  FEATURE_TYPE ListSorter_2_OUTPUT    OUTPUT FEATURE_TYPE ListConcatenator_2_OUTPUT         @Tcl2(ListConcatenator_2__Concatenate)
