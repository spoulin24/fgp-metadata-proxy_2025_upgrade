FACTORY_DEF {*} WriterFactory    FACTORY_NAME $(FFS_CAPTURE_WORKSPACE_NAME)_FeatureWriter    WRITER_TYPE FFS    WRITER_DATASET "$(FeatureWriterDataset_$(FFS_CAPTURE_WORKSPACE_NAME)_FeatureWriter)"    WRITER_SETTINGS "RUNTIME_MACROS,PASSPHRASE<comma><comma>INDEXED<comma>no<comma>COMPRESSION_LEVEL<comma>0<comma>REQUIRES_FEATURE_TABLES<comma>No<comma>STORE_SCANNED_SCHEMA<comma>No<comma>ATTRIBUTE_TYPE_SCANNING<comma><lt>Unused<gt><comma>STORE_SCANNED_METADATA<comma>No<comma>ADVANCED_GROUP<comma><comma>MAX_FILE_SIZE<comma><comma>DESTINATION_DATASETTYPE_VALIDATION<comma>No<comma>COORDINATE_SYSTEM_GRANULARITY<comma>FEATURE<comma>FILE_DEST_DATASET<comma>yes,METAFILE,FFS"    WRITER_METAFILE "ATTRIBUTE_CASE,ANY,ATTRIBUTE_INVALID_CHARS,,ATTRIBUTE_LENGTH,4000,ATTR_TYPE_MAP,char<openparen>width<closeparen><comma>fme_char<openparen>width<closeparen><comma>varchar<openparen>width<closeparen><comma>fme_varchar<openparen>width<closeparen><comma>buffer<comma>fme_buffer<comma>xml<comma>fme_xml<comma>json<comma>fme_json<comma>binary<openparen>width<closeparen><comma>fme_binary<openparen>width<closeparen><comma>varbinary<openparen>width<closeparen><comma>fme_varbinary<openparen>width<closeparen><comma>binarybuffer<comma>fme_binarybuffer<comma>datetime<comma>fme_datetime<comma>time<comma>fme_time<comma>date<comma>fme_date<comma>real64<comma>fme_real64<comma>real32<comma>fme_real32<comma>int32<comma>fme_int32<comma>uint32<comma>fme_uint32<comma>int64<comma>fme_int64<comma>uint64<comma>fme_uint64<comma>logical<comma>fme_boolean<comma>int16<comma>fme_int16<comma>uint16<comma>fme_uint16<comma>int8<comma>fme_int8<comma>uint8<comma>fme_uint8<comma><quote>number<openparen>width<comma>decimal<closeparen><quote><comma><quote>fme_decimal<openparen>width<comma>decimal<closeparen><quote>,DEST_ILLEGAL_ATTR_LIST,,FEATURE_TYPE_CASE,ANY,FEATURE_TYPE_INVALID_CHARS,,FEATURE_TYPE_LENGTH,0,FEATURE_TYPE_LENGTH_INCLUDES_PREFIX,false,FEATURE_TYPE_RESERVED_WORDS,,FORMAT_METAFILE,$(FME_HOME_ENCODED)metafile<backslash>FFS.fmf,FORMAT_NAME,FFS,GEOM_MAP,fme_point<comma>fme_point<comma>fme_line<comma>fme_line<comma>fme_area<comma>fme_polygon<comma>fme_text<comma>fme_text<comma>fme_ellipse<comma>fme_ellipse<comma>fme_arc<comma>fme_arc<comma>fme_rectangle<comma>fme_rectangle<comma>fme_rounded_rectangle<comma>fme_rounded_rectangle<comma>fme_raster<comma>fme_raster<comma>fme_collection<comma>fme_collection<comma>fme_surface<comma>fme_surface<comma>fme_solid<comma>fme_solid<comma>fme_point_cloud<comma>fme_point_cloud<comma>fme_feature_table<comma>fme_feature_table<comma>fme_no_geom<comma>fme_no_geom<comma><comma>fme_no_geom<comma>fme_no_map<comma>fme_no_geom,READER_ATTR_INDEX_TYPES,,READER_USES_DEF,yes,SOURCE,no,SUPPORTS_FEAT_TYPE_FANOUT,yes,SUPPORTS_MULTI_GEOM,yes,WORKBENCH_CANNED_SCHEMA,,WRITER,FFS,WRITER_ATTR_INDEX_TYPES,,WRITER_DEFLINE_PARMS,,WRITER_DEF_LINE_TEMPLATE,<opencurly>FME_GEN_GROUP_NAME<closecurly>,WRITER_FORMAT_PARAMETER,DATASET_NAME<comma><quote>ffs<space>file<quote><comma>READER_DATASET_HINT<comma><quote>Select<space>the<space>FFS<space>file<openparen>s<closeparen><quote><comma>WRITER_DATASET_HINT<comma><quote>Specify<space>a<space>name<space>for<space>the<space>FFS<space>file<quote>,WRITER_HAS_DEFLINE_ATTRS,yes,WRITER_USES_DEF,yes"    WRITER_FEATURE_TYPES "<at>Value<openparen>fme_feature_type<closeparen>:Output,ftp_feature_type_name_exp,<at>Value<openparen>fme_feature_type<closeparen>,ftp_writer,FFS,ftp_dynamic_schema,no,ftp_dynamic_feature_type_name_type,DYN_SCHEMA_PROP_AUTO,ftp_dynamic_geometry_type,DYN_SCHEMA_PROP_AUTO,ftp_dynamic_schema_def_name_type,DYN_SCHEMA_PROP_AUTO,ftp_dynamic_schema_sources,<lt>lt<gt>Unused<lt>gt<gt>,ftp_attribute_source,0,ftp_user_attributes,_transformer<comma>varchar<lt>openparen<gt>200<lt>closeparen<gt><comma>_port<comma>varchar<lt>openparen<gt>200<lt>closeparen<gt>,ftp_user_attribute_values,<comma>"    WRITER_PARAMS "COMPRESSION_LEVEL,0,STORE_SCANNED_SCHEMA,No,DESTINATION_DATASETTYPE_VALIDATION,No,COORDINATE_SYSTEM_GRANULARITY,FEATURE,FILE_DEST_DATASET,yes,INDEXED,no,STORE_SCANNED_METADATA,No,REQUIRES_FEATURE_TABLES,No"    DATASET_ATTR "_dataset"    FEATURE_TYPE_LIST_ATTR "_feature_type"    TOTAL_FEATURES_WRITTEN_ATTR "_total_features_written"    OUTPUT_PORTS ""    INPUT Output FEATURE_TYPE "$(FFS_CAPTURE_WORKSPACE_NAME)_AttributeCreator_OUTPUT"  @FeatureType(ENCODED,@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_feature_type<closeparen>,$(FFS_CAPTURE_WORKSPACE_NAME)_FeatureWriter))    @SupplyAttributes(ENCODED,fme_template_feature_type,Output)    OUTPUT SUMMARY FEATURE_TYPE "$(FFS_CAPTURE_WORKSPACE_NAME)_FeatureWriter_SUMMARY"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(FFS_CAPTURE_WORKSPACE_NAME)_Output1758739745 Output Collector"   INPUT FEATURE_TYPE "$(FFS_CAPTURE_WORKSPACE_NAME)_FeatureWriter_SUMMARY"   OUTPUT FEATURE_TYPE "$(FFS_CAPTURE_WORKSPACE_NAME)_Output"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(FFS_CAPTURE_WORKSPACE_NAME))}]
