DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_c6fedfd4_afe9_4e12_b999_d02c939ed9b51_ATTRS_TO_EVALUATE
INCLUDE [    if {{OUTGOING} == {OUTGOING}} {       if {[string length {_TMinMessagePersonalis<u00e9>}] == 0} { return; };       set attrs [list {_TMinMessagePersonalis<u00e9>}];    } else {       set attrs [split {<Unused>} { }];    };    set clauses {};    foreach attr $attrs {       lappend clauses "ATTR";       lappend clauses "{";       lappend clauses $attr;       lappend clauses {"<at>Value<openparen>_TMMessageUtilisateur<closeparen><space><openparen>Type<space>de<space>test<space>:<space><at>Value<openparen>_TMTypeTest<closeparen><space><semicolon><space>Nombre<space>d<apos>entit<u00e9>s<space>trouv<u00e9><space>:<space><at>Value<openparen>_TMNbElements<closeparen><space><solidus><space>Valeur<space>attendue<space>:<space><openparen>$($(TerminatorMinMax_WORKSPACE_NAME)_NombreEntitesMinimal$encode)<comma>$($(TerminatorMinMax_WORKSPACE_NAME)_NombreEntitesMaximal$encode)<closeparen><closeparen>"};       lappend clauses "}";    };    puts "MACRO $(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_c6fedfd4_afe9_4e12_b999_d02c939ed9b51_ATTRS_TO_EVALUATE [join $clauses { }]"; ]
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator }    INPUT  FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_ParameterFetcher_2_OUTPUT"    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    $($(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_c6fedfd4_afe9_4e12_b999_d02c939ed9b51_ATTRS_TO_EVALUATE)    OUTPUT { OUTPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_OUTPUT"        }
