# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_Terminator }    INPUT  FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_TMinMessagePersonalis<u00e9><closeparen>,$(TerminatorMinMax_WORKSPACE_NAME)_Terminator)")       @SupplyAttributes(_wb_termination_xformer,"$(TerminatorMinMax_WORKSPACE_NAME)_Terminator")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_TMinMessagePersonalis<u00e9><closeparen>,$(TerminatorMinMax_WORKSPACE_NAME)_Terminator)") }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_INPUT }    INPUT  FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_4_VALIDE"    OUTPUT { FEATURE_TYPE $(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_INPUTLINE }
FACTORY_DEF {*} TestFactory FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5 } INPUT FEATURE_TYPE $(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_TMSource<closeparen>,$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5) = EntiteBidon ENCODED } BOOLEAN_OPERATOR OR OUTPUT PASSED_0 FEATURE_TYPE $(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_EntiteBidon OUTPUT FAILED FEATURE_TYPE $(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_<lt>UNFILTERED<gt>
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5 EntiteBidon Splitter"   INPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_EntiteBidon"   OUTPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_EntiteBidon_0_QciUm3FVxIk="   OUTPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_EntiteBidon_1_YeijFYc7xEQ="
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5 <lt>UNFILTERED<gt> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_<lt>UNFILTERED<gt>"
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(TerminatorMinMax_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(TerminatorMinMax_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_EntiteBidon_0_QciUm3FVxIk="    INPUT  FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_7_SURPLUS"    OUTPUT { FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,_TMSource,_TMcreation_instance,_TMCount,_TMinAttributBidon,_TMinNbElementsAvecBidon,_TMNbElements,_TMTypeTest,_TMValide)        $($(TerminatorMinMax_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttributeKeeperFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_AttributeKeeper_2 }    INPUT  FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_TestFilter_5_EntiteBidon_1_YeijFYc7xEQ="    KEEP_ATTRS { _TMNbElements,_TMTypeTest,_TMValide }    KEEP_LISTS {  }    KEEP_FME_ATTRIBUTES Yes    BUILD_FEATURE_TABLES { NO }    OUTPUT_ON_ATTRIBUTE_CHANGE { <Unused> }    OUTPUT { OUTPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_AttributeKeeper_2_OUTPUT"        }
# -------------------------------------------------------------------------
DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_2_d2dcb97d_9c85_405e_9ef9_2f273e14545c1_ATTRS_TO_EVALUATE
INCLUDE [    if {{OUTGOING} == {OUTGOING}} {       if {[string length {_TMMessagePersonalis<u00e9>}] == 0} { return; };       set attrs [list {_TMMessagePersonalis<u00e9>}];    } else {       set attrs [split {<Unused>} { }];    };    set clauses {};    foreach attr $attrs {       lappend clauses "ATTR";       lappend clauses "{";       lappend clauses $attr;       lappend clauses {"Type<space>de<space>test<space>:<space><at>Value<openparen>_TMTypeTest<closeparen><space><semicolon><space>Nombre<space>d<apos>entit<u00e9><space>:<space><at>Value<openparen>_TMNbElements<closeparen><space><semicolon><space>Seuils<space>:<space><openparen>$($(TerminatorMinMax_WORKSPACE_NAME)_NombreEntitesMinimal$encode)<comma>$($(TerminatorMinMax_WORKSPACE_NAME)_NombreEntitesMaximal$encode)<closeparen><space><semicolon><space>Valide<space>:<space><at>Value<openparen>_TMValide<closeparen>"};       lappend clauses "}";    };    puts "MACRO $(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_2_d2dcb97d_9c85_405e_9ef9_2f273e14545c1_ATTRS_TO_EVALUATE [join $clauses { }]"; ]
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_2 }    INPUT  FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_AttributeKeeper_2_OUTPUT"    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    $($(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_2_d2dcb97d_9c85_405e_9ef9_2f273e14545c1_ATTRS_TO_EVALUATE)    OUTPUT { OUTPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_2_OUTPUT"        }
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {$(TerminatorMinMax_WORKSPACE_NAME)_Logger_d75b86b8_43db_4207_ab9d_cfaee658028e1} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME $(TerminatorMinMax_WORKSPACE_NAME)_Logger
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_Logger_Logger }    INPUT  FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_StringConcatenator_2_OUTPUT"    OUTPUT { FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_Logger_LOGGED"                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_TMMessagePersonalis<u00e9><closeparen>,$(TerminatorMinMax_WORKSPACE_NAME)_Logger)","0","1","",INFO,LOG_RECORD,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(TerminatorMinMax_WORKSPACE_NAME)_Logger LOGGED Transformer Output Nuker"   INPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_Logger_LOGGED"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(TerminatorMinMax_WORKSPACE_NAME)_OUTPUT1759785878 Output Collector"   INPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_AttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_OUTPUT"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(TerminatorMinMax_WORKSPACE_NAME))}]
#! <?xml version="1.0" encoding="UTF-8" ?>
#! <TRANSFORMER
# TRANSFORMER_BEGIN TerminatorMinMax,1,CITS,cfc1e0cd-b499-4969-928a-f67301697777,"Linked by Default",No,NO_PARALLELISM,,No,19238,YES,No,35,No
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">Ce custom transformer est utilisé pour vérifier si le nombre d'entités traitées est acceptable. </p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">Si le nombre d'entités n'est pas respecté, le programme génère une erreur. &lt;br/&gt;</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">Le custom ne génère pas d'erreur si : </p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">Seuil minimal &lt;= Nombre d'entités traitées &lt;=Seuil maximal&lt;br/&gt;</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">Documentation : &lt;a href="\\dfscitsh\cits\envcits\applications\cits\pro\doc\TerminatorMinMax.doc"&gt;TerminatorMinMax.doc&lt;/a&gt;&lt;br/&gt;</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">Note : Les données entrantes ressortent intactes du transformer afin de pouvoir au besoin mettre</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">le transformer au milieu d'une chaine de traitement, mais le transformer peut aussi être utilisé en fin</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">de traitement</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;h2&gt;Paramètres : &lt;/h2&gt;</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;p&gt;Termination message  : &lt;/p&gt; &lt;li/&gt;Message d'erreur à inscrire dans le log. </p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;li/&gt;Le nombre d'élément trouvé / nombre d'élément attendu sera automatiquement ajouté au message&lt;br/&gt;</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">Nombre minimal d'entités :</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;li/&gt;Nombre minimal d'entité attendu. Si le nombre d'entités trouvées  est plus petit (&lt;) que le nombre attendu, le programme génère une erreur. </p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;li/&gt;Mettre un chiffre ou utiliser * pour indiquer qu'il n'y a pas de minimum</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;li/&gt;Toute valeur autre qu'un nombre entier est traité comme * &lt;br/&gt;</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">Nombre maximal d'entités :</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;li/&gt;Nombre maximal d'entité attendu. Si le nombre d'entités trouvées  est plus grand (&gt;) que le nombre attendu, le programme génère une erreur.</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;li/&gt;Mettre un chiffre ou utiliser * pour indiquer qu'il n'y a pas de maximum </p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;li/&gt;Toute valeur autre qu'un nombre entier est traité comme *&lt;br/&gt;</p>
# <p style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">&lt;br/&gt;</p>
# <p style="-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;">
#     <br/>
# </p>
# 
# TRANSFORMER_END
#!   ATTR_TYPE_ENCODING="SDF"
#!   BLOCKED_LOOPING="No"
#!   CATEGORY="CITS"
#!   DESCRIPTION="&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Ce custom transformer est utilisé pour vérifier si le nombre d&apos;entités traitées est acceptable. &lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Si le nombre d&apos;entités n&apos;est pas respecté, le programme génère une erreur. &amp;lt;br/&amp;gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Le custom ne génère pas d&apos;erreur si : &lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Seuil minimal &amp;lt;= Nombre d&apos;entités traitées &amp;lt;=Seuil maximal&amp;lt;br/&amp;gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Documentation : &amp;lt;a href=&quot;\\dfscitsh\cits\envcits\applications\cits\pro\doc\TerminatorMinMax.doc&quot;&amp;gt;TerminatorMinMax.doc&amp;lt;/a&amp;gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Note : Les données entrantes ressortent intactes du transformer afin de pouvoir au besoin mettre&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;le transformer au milieu d&apos;une chaine de traitement, mais le transformer peut aussi être utilisé en fin&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;de traitement&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;h2&amp;gt;Paramètres : &amp;lt;/h2&amp;gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;p&amp;gt;Termination message  : &amp;lt;/p&amp;gt; &amp;lt;li/&amp;gt;Message d&apos;erreur à inscrire dans le log. &lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;li/&amp;gt;Le nombre d&apos;élément trouvé / nombre d&apos;élément attendu sera automatiquement ajouté au message&amp;lt;br/&amp;gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Nombre minimal d&apos;entités :&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;li/&amp;gt;Nombre minimal d&apos;entité attendu. Si le nombre d&apos;entités trouvées  est plus petit (&amp;lt;) que le nombre attendu, le programme génère une erreur. &lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;li/&amp;gt;Mettre un chiffre ou utiliser * pour indiquer qu&apos;il n&apos;y a pas de minimum&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;li/&amp;gt;Toute valeur autre qu&apos;un nombre entier est traité comme * &amp;lt;br/&amp;gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Nombre maximal d&apos;entités :&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;li/&amp;gt;Nombre maximal d&apos;entité attendu. Si le nombre d&apos;entités trouvées  est plus grand (&amp;gt;) que le nombre attendu, le programme génère une erreur.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;li/&amp;gt;Mettre un chiffre ou utiliser * pour indiquer qu&apos;il n&apos;y a pas de maximum &lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;li/&amp;gt;Toute valeur autre qu&apos;un nombre entier est traité comme *&amp;lt;br/&amp;gt;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&amp;lt;br/&amp;gt;&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&#10;    &lt;br/&gt;&#10;&lt;/p&gt;&#10;"
