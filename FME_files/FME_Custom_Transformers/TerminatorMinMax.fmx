Tcl2 set $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_noinput 1;
Tcl2 proc $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_groupKey {} {     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_groupCount;     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_noinput;     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data;     set key {};     set COMMENT { Initialize structures if this is the first time we've seen this group key.  };     upvar 0 $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_groupCount($key) groupCount;     if [info exists groupCount] {         incr groupCount;     } else {         set groupCount 0;         if { ![info exists $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_noinput($key)] } {             if {{} != {}} {set dolist 1} else {set dolist 0};             set "$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data([list $key sum])"      0.0;             set "$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data([list $key sumsq])"    0.0;             set "$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data([list $key count])"    0;             set "$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data([list $key numcount])" 0;             set "$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data([list $key firstin])"  1;             set "$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data([list $key firstout])" 1;             set "$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data([list $key dolist])"   $dolist;         };     };     return $key; }
Tcl2 proc $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_input {} {     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_noinput;     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data;     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_histo;     set groupKey [$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_groupKey];     upvar 0 $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_histo   histo;     upvar 0 $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_noinput noinput;     foreach element {firstin list dolist sum sumsq count numcount min max mode} {         upvar 0 "$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data([list $groupKey $element])" $element;     };     set noinput 0;     if {[catch {set val [FME_GetAttribute "_TMinAttributBidon"]}]} {       set val {};     };     if {$firstin} {       set min $val;       set max $val;       set firstin 0;     } else {       if {$val < $min} {set min $val};       if {$val > $max} {set max $val};     };     if {$dolist} {lappend list $val};     incr count;     catch {       if {[string is double -strict $val]} {         set sum [expr $sum + $val];         set sumsq [expr $sumsq + double($val * $val)];         incr numcount;       }     };     if {{} != {}} {       set histoKey [list $groupKey $val];       if {[info exists histo($histoKey)]} {         incr histo($histoKey);       } else {         set histo($histoKey) 1;       };     }; }
Tcl2 proc $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_output {outputType} {     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_noinput;     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data;     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_histo;     global $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_groupCount;     upvar 0 $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_histo histo;     upvar 0 $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_noinput noinput;     if {$noinput == 1} {         return;     };     if { \"$outputType\" == \"__SINGLE_GUY__\" } {         set groupKeys [array names $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_groupCount];     } else {         set groupKeys [list [$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_groupKey]];     };     set attrPrefix     {};     set minAttr        {};     set maxAttr        {};     set countAttr      {_TMinNbElementsAvecBidon};     set numericAttr    {};     set sumAttr        {};     set rangeAttr      {};     set meanAttr       {};     set medianAttr     {};     set stdevAttr      {};     set modeAttr       {};     set groupnum -1;     foreach groupKey [lsort $groupKeys] {         foreach element {firstout list dolist sum sumsq count numcount min max range mean median stdev mode} {             upvar 0 "$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_data([list $groupKey $element])" $element ;         };         if {$firstout} {             if {{} != {}} {                 if {$numcount == $count} {                     set list [lsort -real $list];                     if {$count % 2 == 1} {                         set median [lindex $list [expr $count / 2]];                     }                     else {                         set half [expr $count / 2];                         set first [lindex $list [expr $half - 1]];                         set second [lindex $list $half];                         set median [expr double($first + $second) / 2];                     };                 }                 else {                     set median [lindex [lsort $list] [expr int(ceil(double($count) / 2) - 1)]];                 };             };             set range {};             catch {                 set range [expr $max - $min];             };             set mean {};             set stdev {};             if {$numcount > 0} {                 set mean [expr double($sum) / double($numcount)];             };             if {( {} != {} ) && ($numcount > 1)} {                 set tmp [expr double($sumsq * double($numcount)) - double($sum * $sum)];                 if {$tmp >= 0} {                   set stdev [expr sqrt($tmp / double($numcount * double($numcount - 1)))];                 } else {                   set stdev -1;                   FME_LogMessage fme_warn 917353 $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator ;                 };             };             if {{} != {}} {                 set maxHisto 0;                 foreach {name hcount} [array get histo] {                     set histKey [lindex $name 0];                     if { ($histKey == $groupKey) && ($hcount >= $maxHisto) } {                       set maxHisto $hcount;                       set mode [lindex $name end];                      };                 };             };             set firstout 0;         };         if { "(\"$outputType\" == \"__SINGLE_GUY__\")" } {             set attrPrefix \"$(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_stats{[incr groupnum]}.\";             set groupAttrs {};             foreach attr $groupAttrs val $groupKey {                FME_SetAttribute "$attrPrefix$attr" $val;             };         };         if {{} != {}} {             FME_SetAttribute "$attrPrefix$minAttr" $min;         };         if {{} != {}} {             FME_SetAttribute "$attrPrefix$maxAttr" $max;         };         if {{_TMinNbElementsAvecBidon} != {}} {             FME_SetAttribute "$attrPrefix$countAttr" $count;         };         if {{} != {}} {             FME_SetAttribute "$attrPrefix$numericAttr" $numcount;         };         if {{} != {}} {             FME_SetAttribute "$attrPrefix$sumAttr" $sum;         };         if {{} != {}} {             FME_SetAttribute "$attrPrefix$rangeAttr" $range;         };         if {{} != {}} {             FME_SetAttribute "$attrPrefix$meanAttr" $mean;         };         if {{} != {}} {             FME_SetAttribute "$attrPrefix$medianAttr" $median;         };         if {{} != {}} {             FME_SetAttribute "$attrPrefix$stdevAttr" $stdev;         };         if {{} != {}} {             FME_SetAttribute "$attrPrefix$modeAttr" $mode;         };     }; };
FACTORY_DEF * TeeFactory    FACTORY_NAME $(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_Processor    INPUT  FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_AttributeCreator_OUTPUT"    OUTPUT FEATURE_TYPE __ORIGINAL__         @Tcl2($(TerminatorMinMax_WORKSPACE_NAME)_StatisticsCalculator_input)
