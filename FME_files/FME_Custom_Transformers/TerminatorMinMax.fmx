# ============================================================================
DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_Message ERREUR : Aucune entité traitée

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_NombreEntitesMinimal 1

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_NombreEntitesMaximal *

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_DATA_REPOSITORY 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_ENGINE 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_JOB_ID 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SECURITY_ROLES 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SECURITY_USER 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_DEST_DIR 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_HOST 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_PORT 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_REQUEST_HEADERS 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_REQUEST_METHOD 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_REQUEST_PARAMETERS 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_REQUEST_URI 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_RUNTIME_USER 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_RUNTIME_USER_ID 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SERVER_WEB_URL 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SHAREDRESOURCE_BACKUP 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SHAREDRESOURCE_DASHBOARD 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SHAREDRESOURCE_DATA 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SHAREDRESOURCE_ENGINE 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SHAREDRESOURCE_LOG 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SHAREDRESOURCE_SYSTEM 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_SHAREDRESOURCE_TEMP 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_TOPIC 

DEFAULT_MACRO $(TerminatorMinMax_WORKSPACE_NAME)_FME_TOPIC_MESSAGE 

# ============================================================================
#! START_HEADER
#! END_HEADER

DEFAULT_MACRO WB_CURRENT_CONTEXT
DEFAULT_MACRO TerminatorMinMax_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(TerminatorMinMax_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(TerminatorMinMax_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(TerminatorMinMax_WORKSPACE_NAME)_INPUT1759785878 Input Splitter"   INPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_INPUT"   OUTPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_INPUT"
# -------------------------------------------------------------------------
Tcl2 proc $(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_CoordSysRemover {} {   global FME_CoordSys;   set FME_CoordSys {}; }
MACRO $(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_XML     NOT_ACTIVATED
MACRO $(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_GEOJSON NOT_ACTIVATED
INCLUDE [ if { {Geometry Object} == {Geometry Object} } {            puts {MACRO $(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_XML *} } ]
INCLUDE [ if { {Geometry Object} == {GeoJSON} } {            puts {MACRO $(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_GEOJSON *} } ]
FACTORY_DEF {$($(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_XML)} CreationFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_XML_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______        @Geometry(FROM_ENCODED_STRING,<lt>?xml<space>version=<quote>1.0<quote><space>encoding=<quote>US_ASCII<quote><space>standalone=<quote>no<quote><space>?<gt><lt>geometry<gt><lt>null<solidus><gt><lt><solidus>geometry<gt>) }
FACTORY_DEF {$($(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_GEOJSON)} CreationFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_GEOJSON_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______ 	   @SupplyAttributes(ENCODED,__GeoJSONCreatorTemp__,<Unused>)        @JSONGeometry(FROM_ATTRIBUTE,GEOJSON,__GeoJSONCreatorTemp__, PREFER_ERROR_OVER_REJECTION) 	   @RemoveAttributes(__GeoJSONCreatorTemp__) }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_Cloner }    INPUT FEATURE_TYPE _____CREATED______        @Tcl2($(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_CoordSysRemover)        @CoordSys()    NUMBER_OF_COPIES { 1 }    COPY_NUMBER_ATTRIBUTE { "_TMcreation_instance" }    OUTPUT { FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_CREATED"        fme_feature_type $(TerminatorMinMax_WORKSPACE_NAME)_Creator_2         }
FACTORY_DEF * BranchingFactory   FACTORY_NAME "$(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_CREATED Brancher -1 37"   INPUT FEATURE_TYPE "$(TerminatorMinMax_WORKSPACE_NAME)_Creator_2_CREATED"   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   INPUT FEATURE_TYPE *  OUTPUT FEATURE_TYPE *
