#! END_HEADER

DEFAULT_MACRO WB_CURRENT_CONTEXT
DEFAULT_MACRO EMAIL_FORMAT_TESTER_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_INPUT1759777883 Input Splitter"   INPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_INPUT"   OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_INPUT"
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeExposer_2 }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_INPUT"    OUTPUT { FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeExposer_2_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeCreator_2 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeExposer_2_OUTPUT"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "default_email" "SET_TO" "$($(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_DEFAULT_CONTACT_EMAIL$encode)" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeCreator_2_OUTPUT"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_UniqueIdentifierGenerator }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeCreator_2_OUTPUT"    OUTPUT { FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_UniqueIdentifierGenerator_OUTPUT"             "_uuidContacts" @UUID(SIMPLE, UUID_FORMAT, ULID)              }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_UniqueIdentifierGenerator OUTPUT Splitter"   INPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_UniqueIdentifierGenerator_OUTPUT"   OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_UniqueIdentifierGenerator_OUTPUT_0_nJjbF1M7A3k="   OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_UniqueIdentifierGenerator_OUTPUT_1_uNOjUaL6ZWU="
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "contacts<opencurly><closecurly>"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_UniqueIdentifierGenerator_OUTPUT_0_nJjbF1M7A3k="    OUTPUT { FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,)        $($(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttributeKeeperFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeKeeper }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_UniqueIdentifierGenerator_OUTPUT_1_uNOjUaL6ZWU="    KEEP_ATTRS { default_email,_uuidContacts }    KEEP_LISTS { contacts<opencurly><closecurly> }    KEEP_FME_ATTRIBUTES Yes    BUILD_FEATURE_TABLES { NO }    OUTPUT_ON_ATTRIBUTE_CHANGE { <Unused> }    OUTPUT { OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} ElementFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"    LIST_NAME { "contacts{}" }    ELEMENT_NUMBER_FIELD { "_element_index" }    CLONE_GEOMETRY    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "INCOMING_IF_CONFLICT" }    INCOMING_PREFIX { "<Unused>" }    OUTPUT { ELEMENT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder_ELEMENTS"         @RemoveAttributes(ElementFactory.baseCloned)          }    OUTPUT { NOLIST FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder_<REJECTED>"         @RemoveAttributes(ElementFactory.baseCloned)         fme_rejection_code MISSING_PARAMETER_LIST          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder_ELEMENTS"    CASE_INSENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>email<closeparen>,$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester)" CONTAINS "@EvaluateExpression(FDIV,STRING_ENCODED,<at>,$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester)" ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_FAILED"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeCreator }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder_<REJECTED>"    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_FAILED"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "email" "SET_TO" "<at>Value<openparen>default_email<closeparen>" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeCreator_OUTPUT"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Junction }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_PASSED"    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeCreator_OUTPUT"    OUTPUT { FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Junction_Output"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_2 }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Junction_Output"    CASE_INSENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>email<closeparen>,$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_2)" CONTAINS <comma> ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_2_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_2_FAILED"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} StringValueFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeSplitter }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_2_PASSED"    FACTORY_MODE ATTRIBUTE_SPLITTER    ATTR_NAME { email }       DELIMITER { <comma> }       FIELD_QUALIFIER { "" }       TRIM_TYPE { BOTH }       LIST_NAME { email }       DROP_EMPTY_PARTS { NO }    OUTPUT { OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeSplitter_OUTPUT"          }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC }    } else {        puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_3 }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeSplitter_OUTPUT"    OUTPUT { FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"        @RemoveAttributes(fme_encoded,email)        $($(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} ElementFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder_2 }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"    LIST_NAME { "email{}" }    ELEMENT_NUMBER_FIELD { "_element_index" }    CLONE_GEOMETRY    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "INCOMING_IF_CONFLICT" }    INCOMING_PREFIX { "<Unused>" }    OUTPUT { ELEMENT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder_2_ELEMENTS"         @RemoveAttributes(ElementFactory.baseCloned)          }    OUTPUT { NOLIST FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder_2_<REJECTED>"         @RemoveAttributes(ElementFactory.baseCloned)         fme_rejection_code MISSING_PARAMETER_LIST          }
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Terminator_2 }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder_2_<REJECTED>"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"List<space>exploder<space>problem<space>whn<space>exploding<space>email<opencurly><closecurly>")       @SupplyAttributes(_wb_termination_xformer,"$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Terminator_2")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"List<space>exploder<space>problem<space>whn<space>exploding<space>email<opencurly><closecurly>") }
# -------------------------------------------------------------------------
INCLUDE [if { {ATTRIBUTES} == {ATTRIBUTES} } {                puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO ATTRIBUTES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_AND_ATTR_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_AND_ATTR_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} } {                puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} } {                puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          else {}; ]
FACTORY_DEF {*} ReferenceFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT REFERENCER FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"    INPUT REFERENCEE FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListExploder_2_ELEMENTS"    INPUT REFERENCEE FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Tester_2_FAILED"    REFERENCE_INFO { $($(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO) }    REFERENCE_TABLE { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_uuidContacts<closeparen>,$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger) @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_uuidContacts<closeparen>,$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger) AUTO }    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "REQUESTOR_IF_CONFLICT" }    IGNORE_NULLS { "No" }    HANDLE_NULL_MISSING_KEYS_LIKE_FME2013 { No }    LIST_NAME { "contacts" }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { ALL }    MERGE_ATTRIBUTES Yes    MANAGE_FME_TYPE Yes    MODE COMPLETE    PROCESS_DUPLICATE_REFERENCEES { NO }    REFERENCEES_FIRST { No }    REJECT_INVALID_GEOM YES    CLEANING_TOLERANCE { <Unused> }    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    COMPARE_WHITESPACE Yes    OUTPUT { COMPLETE FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_MERGED"         }    OUTPUT { INCOMPLETE FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_UNMERGED_REQUESTOR"         }    OUTPUT { REJECTED FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_<REJECTED>"         }
# -------------------------------------------------------------------------
Tcl2 proc $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListDuplicateRemover_removeDups {} {    set srcIndex 0;    regsub \"{}\" {contacts{}.email} \"{$srcIndex}\"    listKeyAttrName;    regsub \"{}.*$\" {contacts{}.email} \"\{\"          listBase;    regsub \"{}.*$\" {contacts{}.email} \"\{*\"         listBasePattern;    regsub \"{(}.*)$\" {contacts{}.email} {\1}          listSuffix;    regsub \"{}\" {contacts{}.email} \"\\{\[0-9\]*\\}\" listPatternRegExp;    set listPatternRegExp \"^$listPatternRegExp\$\";    set listIndexRegExp   \"^$listBase\(\[0-9\]+\)\}.*\";    set attributeNames [FME_AttributeNames];    set COMMENT {      = Iterate over all attributes. For any that look like src_list{n}.something,      = keep a list in the associative array "listAttributesByIndex(n)". If they      = actually match the key on which we're comparing, store a "true" in the      = associative array "listKeyAttrNameExists()"    };    foreach attrname $attributeNames {       if [regsub $listIndexRegExp $attrname {\1} listIndex] {         lappend listAttributesByIndex($listIndex) $attrname;         if {$attrname ==  \"$listBase$listIndex$listSuffix\"} {           set listKeyAttrNameExists($attrname) true;         };       };    };    set destIndex 0;    set listElementsPattern {};    set haveMissingLast true;    if [catch { set haveNextKey $listKeyAttrNameExists($listKeyAttrName); }] { set haveNextKey false; };    while {[array size listKeyAttrNameExists] > 0 || $haveMissingLast } {        set keyVal [FME_GetAttribute $listKeyAttrName];        if {![info exists dups($keyVal)] && [info exists listAttributesByIndex($srcIndex)]} {            set listElementsPattern \"$listBase$srcIndex\}*\"; 				   set foundSibling 0;            set COMMENT {              = We already have the list of attributes associated with this index. Deal              = with each one of these.            };            foreach listAttrName $listAttributesByIndex($srcIndex)            {               set destAttrName [string replace $listAttrName 0                                 [expr [string length $listElementsPattern] - 3]                                 \"$listBase$destIndex\""];               set destAttrVal [FME_GetAttribute $listAttrName];               if {$destAttrVal == {} && [FME_IsAttributeNull $listAttrName]} {               	   set destAttrVal {FME_NULL_VALUE};               };               set holder($destAttrName) $destAttrVal;               if {$foundSibling == 0  } {                   set dups($keyVal) {};                   set foundSibling 1;               };            };            if {$foundSibling && $keyVal == {} && ![FME_AttributeExists $listKeyAttrName]}            {               set dups($keyVal) {};               set missingAttrName [string replace $listKeyAttrName 0                                 [expr [string length $listElementsPattern] - 3]                                 \"$listBase$destIndex\""];               set holder($missingAttrName) {FME_MISSING_VAL};            };            if {$foundSibling} {                incr destIndex;            };        };        if $haveNextKey {          unset listKeyAttrNameExists($listKeyAttrName);        };        incr srcIndex;        regsub \"{}\" {contacts{}.email} \"{$srcIndex}\" listKeyAttrName;        if [catch { set haveNextKey $listKeyAttrNameExists($listKeyAttrName); }] { set haveNextKey false; };        if {[array size listKeyAttrNameExists] == 0} {            set COMMENT {              = Once we've exhausted all of the actual sort keys, keep looking for structured              = elements within the list that don't have an accompanying sort key.            };            set haveMissingLast [info exists listAttributesByIndex($srcIndex)];        };    };    foreach attrname $attributeNames { 		 if {[string match $listBasePattern $attrname]} { 		   FME_UnsetAttributes $attrname; 		 };    };    foreach newListAttrName [array names holder] {        if {$holder($newListAttrName) == {FME_NULL_VALUE}} {           FME_SetAttributeNull $newListAttrName        } elseif { $holder($newListAttrName) != {FME_MISSING_VAL} } {           FME_SetAttribute $newListAttrName $holder($newListAttrName);        };    }; };
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListDuplicateRemover }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_MERGED"    OUTPUT { FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListDuplicateRemover_OUTPUT"         @Tcl2("$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListDuplicateRemover_removeDups")          }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "contacts<opencurly><closecurly>._element_index contacts<opencurly><closecurly>._uuidContacts contacts<opencurly><closecurly>.default_email contacts<opencurly><closecurly>.fme_rejection_code"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ListDuplicateRemover_OUTPUT"    OUTPUT { FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,_element_index,email,default_email,fme_rejection_code,_uuidContacts)        $($(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER Input Input Collector"   INPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"   OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_Input"
MACRO ATTRIBUTE_UNEXPOSER_WORKSPACE_NAME $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER
MACRO $(ATTRIBUTE_UNEXPOSER_WORKSPACE_NAME)_TRANSFORMER_GROUP 
MACRO $(ATTRIBUTE_UNEXPOSER_WORKSPACE_NAME)_XFORMER_NAME $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER
INCLUDE_CUSTOM_TRANSFORMER_VER ATTRIBUTE_UNEXPOSER:2
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER Output Output Renamer/Nuker"   INPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_Output"   OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_Output"
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Terminator }    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_UNMERGED_REQUESTOR"    INPUT  FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_FeatureMerger_<REJECTED>"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"Feature<space>Merger<space>error:<space>Translation<space>Terminated")       @SupplyAttributes(_wb_termination_xformer,"$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_Terminator")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"Feature<space>Merger<space>error:<space>Translation<space>Terminated") }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_OUTPUT1759777883 Output Collector"   INPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_Output"   OUTPUT FEATURE_TYPE "$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME)_OUTPUT"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(EMAIL_FORMAT_TESTER_WORKSPACE_NAME))}]
#! <?xml version="1.0" encoding="UTF-8" ?>
#! <TRANSFORMER
# TRANSFORMER_BEGIN EMAIL_FORMAT_TESTER,1,"FGP Tools",fede3cfc-5cd8-4fd2-9391-4ba654b13c66,"Linked by Default",No,NO_PARALLELISM,,No,20200,YES,No,37,No,
# <p><strong>Description </strong></p>
# <p>This custom transformer corrects wrongly formed email addresses.  It manages two cases: firstly when the email address do not contain the character"@", the email address is replaced by the default email adress; secondly when addresses are separated by coma, the email addresses are separated and placed into independant list of contacts{}.</p>
# <p><strong>Input Ports </strong></p>
# <ul>
# <li>INPUT: The input metadata records to process.</li>
# </ul>
# <p><strong>Output Ports </strong></p>
# <ul>
# <li>OUTPUT: The process output metadata records with email addresses corrected.</li>
# </ul>
# <p><strong>Parameters </strong></p>
# <ul>
# <li>DEFAULT_CONTACT_EMAIL: Name of the attribute containing the default email address or string character representing the default email address</li>
# </ul>
# TRANSFORMER_END
#!   ATTR_TYPE_ENCODING="SDF"
#!   BLOCKED_LOOPING="No"
#!   CATEGORY="FGP Tools"
#!   DESCRIPTION="&lt;p&gt;&lt;strong&gt;Description &lt;/strong&gt;&lt;/p&gt;&#10;&lt;p&gt;This custom transformer corrects wrongly formed email addresses.  It manages two cases: firstly when the email address do not contain the character&quot;@&quot;, the email address is replaced by the default email adress; secondly when addresses are separated by coma, the email addresses are separated and placed into independant list of contacts{}.&lt;/p&gt;&#10;&lt;p&gt;&lt;strong&gt;Input Ports &lt;/strong&gt;&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;INPUT: The input metadata records to process.&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;&lt;strong&gt;Output Ports &lt;/strong&gt;&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;OUTPUT: The process output metadata records with email addresses corrected.&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;&lt;strong&gt;Parameters &lt;/strong&gt;&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;DEFAULT_CONTACT_EMAIL: Name of the attribute containing the default email address or string character representing the default email address&lt;/li&gt;&#10;&lt;/ul&gt;"
#!   DOC_EXTENTS="12215.4 1821.89"
#!   DOC_TOP_LEFT="-4884.42 -778.133"
#!   EXPLICIT_BOOKMARK_ORDER="false"
#!   FME_BUILD_NUM="20200"
#!   FME_DOCUMENT_GUID="fede3cfc-5cd8-4fd2-9391-4ba654b13c66"
#!   FME_DOCUMENT_PRIORGUID="27b8f837-3532-48a5-8c5f-33dd0307c9b1,ecff3433-635b-4827-8f22-665159e29ae0,37f576b5-363c-488d-8ef0-8a80bec4ba84"
#!   FME_LINKED_TRANSFORMER_VERSION="1"
