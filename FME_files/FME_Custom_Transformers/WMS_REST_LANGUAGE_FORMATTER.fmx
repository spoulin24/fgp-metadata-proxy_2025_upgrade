FME_PYTHON_VERSION 37
#! START_HEADER
#! END_HEADER

DEFAULT_MACRO WB_CURRENT_CONTEXT
DEFAULT_MACRO WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_INPUT1743531412 Input Splitter"   INPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_INPUT"   OUTPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_INPUT"
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory    FACTORY_NAME $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeExposer_2    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_INPUT"    OUTPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeExposer_2_OUTPUT"
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory    FACTORY_NAME $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_UUIDGenerator_2    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeExposer_2_OUTPUT"    OUTPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_UUIDGenerator_2_OUTPUT"         "_uuid_wms_rest" @UUID()
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_UUIDGenerator_2 OUTPUT Splitter"   INPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_UUIDGenerator_2_OUTPUT"   OUTPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_UUIDGenerator_2_OUTPUT_0_WkiMoOwrTzw="   OUTPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_UUIDGenerator_2_OUTPUT_1_32HouA6YFIY="
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttributeKeeperFactory    FACTORY_NAME $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeKeeper    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_UUIDGenerator_2_OUTPUT_1_32HouA6YFIY="    KEEP_ATTRS { _uuid_wms_rest }    KEEP_LISTS { resources<opencurly><closecurly> }    KEEP_FME_ATTRIBUTES Yes    BUILD_FEATURE_TABLES { No }    OUTPUT_ON_ATTRIBUTE_CHANGE {  }    OUTPUT { OUTPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"        }
# -------------------------------------------------------------------------
FACTORY_DEF * ElementFactory    FACTORY_NAME $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_LIST_EXPLODER_1    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"    LIST_NAME "resources{}"    ELEMENT_NUMBER_FIELD "_element_index"    CLONE_GEOMETRY    ATTR_ACCUM_MODE "HANDLE_CONFLICT"    ATTR_CONFLICT_RES "INCOMING_IF_CONFLICT"    INCOMING_PREFIX "<Unused>"    OUTPUT ELEMENT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_LIST_EXPLODER_1_ELEMENTS"         @RemoveAttributes(ElementFactory.baseCloned)    OUTPUT NOLIST FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_LIST_EXPLODER_1_<REJECTED>"         @RemoveAttributes(ElementFactory.baseCloned)         fme_rejection_code MISSING_PARAMETER_LIST
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TestFactory    FACTORY_NAME $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_Terminator_7    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_LIST_EXPLODER_1_<REJECTED>"    TEST "$(_WB_BYPASS_TERMINATION)" == Yes    OUTPUT PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"List<space>Exploder<space>error:<space>Translation<space>Terminated")       @SupplyAttributes(_wb_termination_xformer,"$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_Terminator_7")       @SupplyAttributes(_wb_termination_feature,Yes)    OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED,"List<space>Exploder<space>error:<space>Translation<space>Terminated")
# -------------------------------------------------------------------------
FACTORY_DEF * TestFactory    FACTORY_NAME $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_Tester    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_LIST_EXPLODER_1_ELEMENTS"    CASE_INSENSITIVE_TEST "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>url<closeparen>,$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_Tester)" CONTAINS https ENCODED    BOOLEAN_OPERATOR OR    COMPOSITE_TEST_EXPR "<Unused>"    OUTPUT PASSED FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_Tester_PASSED"    OUTPUT FAILED FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_Tester_FAILED"
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeCreator_5    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_Tester_FAILED"    MULTI_FEATURE_MODE NO    NULL_ATTR_MODE NO_OP     ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV     ATTR_ACTION { "" "protocol" "SET_TO" "HTTP" }    OUTPUT OUTPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeCreator_5_OUTPUT"
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeCreator_4    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_Tester_PASSED"    MULTI_FEATURE_MODE NO    NULL_ATTR_MODE NO_OP     ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV     ATTR_ACTION { "" "protocol" "SET_TO" "HTTPS" }    OUTPUT OUTPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeCreator_4_OUTPUT"
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME $(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeCreator_10    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeCreator_4_OUTPUT"    INPUT  FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeCreator_5_OUTPUT"    MULTI_FEATURE_MODE NO    NULL_ATTR_MODE NO_OP     ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV     ATTR_ACTION { "" "xlink_role" "SET_TO" "" }    OUTPUT OUTPUT FEATURE_TYPE "$(WMS_REST_LANGUAGE_FORMATTER_WORKSPACE_NAME)_AttributeCreator_10_OUTPUT"
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
