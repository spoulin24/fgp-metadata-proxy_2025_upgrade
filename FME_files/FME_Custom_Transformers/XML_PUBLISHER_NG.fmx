FACTORY_DEF * TestFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_2    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_3_PASSED"    CASE_INSENSITIVE_TEST "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>query_response<closeparen>,$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_2)" != error ENCODED    BOOLEAN_OPERATOR OR    COMPOSITE_TEST_EXPR "1"    OUTPUT PASSED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_2_PASSED"    OUTPUT FAILED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_2_FAILED"
