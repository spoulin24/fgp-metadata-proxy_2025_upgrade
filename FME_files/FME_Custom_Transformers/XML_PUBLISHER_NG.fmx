FACTORY_DEF {*} AttributeKeeperFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_2 }    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_PyCSW_POST_1_OUTPUT_1_6FVnaqkEzDw="    KEEP_ATTRS { _writing_order,nombre_transaction }    KEEP_LISTS {  }    KEEP_FME_ATTRIBUTES Yes    BUILD_FEATURE_TABLES { NO }    OUTPUT_ON_ATTRIBUTE_CHANGE { <Unused> }    OUTPUT { OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_2_OUTPUT"        }
# -------------------------------------------------------------------------
# If we're doing LAST N features, then the multiplier comes in as 0.
# If we're doing First N, multiplier is -1.
# For RANDOM, we need to treat LAST N as if it was first N (i.e. have a -1)
# That is what the ? : does in the rate multiplier.
INCLUDE [ if { {1} == {0} && {ORIGINAL} == {ORIGINAL} } {              puts "MACRO REAL_MODE LAST"; 	         puts "MACRO REAL_RATE 5"; 	      } else {              puts "MACRO REAL_MODE ORIGINAL";              puts "MACRO REAL_RATE [expr 5 * ( 1 ? 1 : -1 ) ]"; 	      } ]
FACTORY_DEF {*} SamplingFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Sampler }    COMMAND_PARM_EVALUATION SINGLE_PASS    SAMPLE_RATE { $(REAL_RATE) }    SAMPLE_ORDER { $(REAL_MODE) }    GROUP_BY { _writing_order }    FLUSH_WHEN_GROUPS_CHANGE { No }    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_2_OUTPUT"    OUTPUT { SAMPLED FEATURE_TYPE ___SAMPLED___ }
# This TeeFactory is needed because Sampler will still output features if it has no OUTPUT clauses specified.
# This way we behave nicely even if there are no output connections on the transformer. See PR#28886.
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Sampler_Sampled }    INPUT FEATURE_TYPE ___SAMPLED___    OUTPUT { FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Sampler_SAMPLED"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} CounterFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    START { "1" }    SCOPE { Local }    DOMAIN { "<Unused>" }    COUNT_ATTR { "_count" }    GROUP_ID_ATTR { "" }    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Sampler_SAMPLED"    OUTPUT { OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_OUTPUT"        }    OUTPUT { REJECTED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_<REJECTED>"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_10 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_OUTPUT"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "nb_record" "SET_TO" "<at>Evaluate<openparen><at>Value<openparen>_count<closeparen>*5<closeparen>" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_10_OUTPUT"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_6 }    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_10_OUTPUT"    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_writing_order<closeparen>,$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_6)" = 1 ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_6_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_6_FAILED"         }
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_f3c62d5e_51df_4fdf_8f0e_097b3f43330e2} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_Logger }    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_6_PASSED"    OUTPUT { FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_LOGGED"                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,Pycsw<space>transaction<space>-<space>Delete<space><openparen><at>Value<openparen>nb_record<closeparen>*10<solidus><at>Value<openparen>nombre_transaction<closeparen><closeparen>,$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger)","<Unused>","1000","",INFO,NONE,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger LOGGED Transformer Output Nuker"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_LOGGED"
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_2_f63e9107_43d8_492c_ac1c_937c42bbb8142} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_2
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_2_Logger }    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_6_FAILED"    OUTPUT { FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_2_LOGGED"                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,Pycsw<space>transaction<space>-<space>Insert<space><space><openparen><at>Value<openparen>nb_record<closeparen><solidus><at>Value<openparen>nombre_transaction<closeparen><closeparen>,$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_2)","<Unused>","1000","",INFO,NONE,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_2 LOGGED Transformer Output Nuker"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Logger_2_LOGGED"
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Terminator_5 }    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_4_FAILED"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"ERROR:<space>PYCSW<space>url<space>is<space>not<space>defined")       @SupplyAttributes(_wb_termination_xformer,"$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Terminator_5")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"ERROR:<space>PYCSW<space>url<space>is<space>not<space>defined") }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_LOCAL1759786041 Output Collector"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_5_PASSED"   OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_LOCAL"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_INSERT_PASSED1759786041 Output Collector"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_2_Insert"   OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_INSERT_PASSED"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_INSERT_FAILED1759786041 Output Collector"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_3_Insert"   OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_INSERT_FAILED"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_UPDATE_PASSED1759786041 Output Collector"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_2_Update"   OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_UPDATE_PASSED"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_UPDATE_FAILED1759786041 Output Collector"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_3_Update"   OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_UPDATE_FAILED"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_InvalidMetadata1759786041 Output Collector"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLValidator_2_FAILED"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLFormatter_2_FAILED"   OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_InvalidMetadata"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(XML_PUBLISHER_NG_WORKSPACE_NAME))}]
#! <?xml version="1.0" encoding="UTF-8" ?>
#! <TRANSFORMER
# TRANSFORMER_BEGIN XML_PUBLISHER_NG,1,"FGP Tools",1f452a71-ca14-42ba-9e6d-19b4ea8cd658,"Linked by Default",No,NO_PARALLELISM,,No,20200,YES,No,37,No,
# <p><strong>Description </strong></p>
# <p>This custom transformer is translating the input spatial metadata records into the XML HNAP model.  The rules on how to map the input features attributes (records) into the HNAP attributes are stored in the XML configuration file. The XML templates used to create the output HNAP XML file are supplied with the input published parameters of the custom transformers.  The mapping into XML file is done with FME XML Templater transformer.  If the publish parameter LOCAL_WRITER is set to NO, the custom tranformer will insert or update the records in thePyCSW.</p>
# <p>Note: Because of a problem with the PyCSW server, record update are done in 2 steps: first the record is deleted; secondly the record is inserted.</p>
# <p><strong>Input Ports </strong></p>
# <ul>
# <li>Input: The input metadata records to translate and write into the XML HNAP model.</li>
# </ul>
# <p><strong>Output Ports </strong></p>
# <ul>
# <li>INSERT_PASSED: The HNAP metdata records that are inserted (new records)</li>
# <li>UPDATE_PASSED: The HNAP metdata records that area updated (edited records)</li>
# <li>INSERT_FAILED: The HNAP metdata records that are inserted (new records) but which failed the PyCSW insert process</li>
# <li>UPDATE_FAILED: The HNAP metdata records that are updated (edited records) but which failed the PyCSW update process</li>
# <li>LOCAL: All HNAP metadata records (insert and iupdate) if LOCAL_WRITER (published parameter) is set to YES</li>
# <li>InvalidMetadata: HNAP metadata records that failed a validation</li>
# </ul>
# <p><strong>Parameters </strong></p>
# <ul>
# <li>TEMPLATE_GMD_CITERESPONSIBILITYPARTY: File system address containing the template section of the CITERESPONSABILITYPARTY of the HNAP model</li>
# <li>TEMPLATE_GMD_CONTACT: File system address containing the template section of the CONTACT of the HNAP model</li>
# <li>TEMPLATE_GMD_DISTRIBUTIONFORMAT: File system address containing the template section of the DISTRIBUTIONFORMAT of the HNAP model</li>
# <li>TEMPLATE_GMD_KEYWORDS: File system address containing the template section of the KEYWORDS of the HNAP model</li>
# <li>TEMPLATE_GMD_MDMETADATA: File system address containing the METADATA root template of the HNAP model</li>
# <li>TEMPLATE_GMD_REFERENCESYSTEMINFO: File system address containing the template section of the REFERENCESYSTEMINFO of the HNAP model</li>
# <li>TEMPLATE_GMD_RESOURCESMAINTENANCE: File system address containing the template section of the RESOURCEMAINTENANCE of the HNAP model</li>
# <li>TEMPLATE_GMD_TOPICCATEGORY: File system address containing the template section of the TOPICCATEGORY of the HNAP model</li>
# <li>TEMPLATE_GMD_TRANSFEROPTION: File system address containing the template section of the TRANSFEROPTION of the HNAP model</li>
# <li>LOCAL_WRITER: Flag indicating if the output records must be written or not to the PyCSW server. YES: Write to the PyCSW server; NO: Do not write to the PyCSW server.</li>
# </ul>
# TRANSFORMER_END
#!   ATTR_TYPE_ENCODING="SDF"
#!   BLOCKED_LOOPING="No"
#!   CATEGORY="FGP Tools"
#!   DESCRIPTION="&lt;p&gt;&lt;strong&gt;Description &lt;/strong&gt;&lt;/p&gt;&#10;&lt;p&gt;This custom transformer is translating the input spatial metadata records into the XML HNAP model.  The rules on how to map the input features attributes (records) into the HNAP attributes are stored in the XML configuration file. The XML templates used to create the output HNAP XML file are supplied with the input published parameters of the custom transformers.  The mapping into XML file is done with FME XML Templater transformer.  If the publish parameter LOCAL_WRITER is set to NO, the custom tranformer will insert or update the records in thePyCSW.&lt;/p&gt;&#10;&lt;p&gt;Note: Because of a problem with the PyCSW server, record update are done in 2 steps: first the record is deleted; secondly the record is inserted.&lt;/p&gt;&#10;&lt;p&gt;&lt;strong&gt;Input Ports &lt;/strong&gt;&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;Input: The input metadata records to translate and write into the XML HNAP model.&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;&lt;strong&gt;Output Ports &lt;/strong&gt;&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;INSERT_PASSED: The HNAP metdata records that are inserted (new records)&lt;/li&gt;&#10;&lt;li&gt;UPDATE_PASSED: The HNAP metdata records that area updated (edited records)&lt;/li&gt;&#10;&lt;li&gt;INSERT_FAILED: The HNAP metdata records that are inserted (new records) but which failed the PyCSW insert process&lt;/li&gt;&#10;&lt;li&gt;UPDATE_FAILED: The HNAP metdata records that are updated (edited records) but which failed the PyCSW update process&lt;/li&gt;&#10;&lt;li&gt;LOCAL: All HNAP metadata records (insert and iupdate) if LOCAL_WRITER (published parameter) is set to YES&lt;/li&gt;&#10;&lt;li&gt;InvalidMetadata: HNAP metadata records that failed a validation&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;&lt;strong&gt;Parameters &lt;/strong&gt;&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;TEMPLATE_GMD_CITERESPONSIBILITYPARTY: File system address containing the template section of the CITERESPONSABILITYPARTY of the HNAP model&lt;/li&gt;&#10;&lt;li&gt;TEMPLATE_GMD_CONTACT: File system address containing the template section of the CONTACT of the HNAP model&lt;/li&gt;&#10;&lt;li&gt;TEMPLATE_GMD_DISTRIBUTIONFORMAT: File system address containing the template section of the DISTRIBUTIONFORMAT of the HNAP model&lt;/li&gt;&#10;&lt;li&gt;TEMPLATE_GMD_KEYWORDS: File system address containing the template section of the KEYWORDS of the HNAP model&lt;/li&gt;&#10;&lt;li&gt;TEMPLATE_GMD_MDMETADATA: File system address containing the METADATA root template of the HNAP model&lt;/li&gt;&#10;&lt;li&gt;TEMPLATE_GMD_REFERENCESYSTEMINFO: File system address containing the template section of the REFERENCESYSTEMINFO of the HNAP model&lt;/li&gt;&#10;&lt;li&gt;TEMPLATE_GMD_RESOURCESMAINTENANCE: File system address containing the template section of the RESOURCEMAINTENANCE of the HNAP model&lt;/li&gt;&#10;&lt;li&gt;TEMPLATE_GMD_TOPICCATEGORY: File system address containing the template section of the TOPICCATEGORY of the HNAP model&lt;/li&gt;&#10;&lt;li&gt;TEMPLATE_GMD_TRANSFEROPTION: File system address containing the template section of the TRANSFEROPTION of the HNAP model&lt;/li&gt;&#10;&lt;li&gt;LOCAL_WRITER: Flag indicating if the output records must be written or not to the PyCSW server. YES: Write to the PyCSW server; NO: Do not write to the PyCSW server.&lt;/li&gt;&#10;&lt;/ul&gt;"
