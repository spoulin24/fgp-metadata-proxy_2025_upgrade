INCLUDE [    set macroLine "MACRO $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_2_8a9881fe_991f_4d2b_9441_4f1d6af0fd660_LIST_EXP ";    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append macroLine ",^$attr$";    };    puts $macroLine; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_2    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_PyCSW_POST_1_OUTPUT_1_6O38xLfNIMQ="    OUTPUT { FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_2_OUTPUT"        @KeepAttributes(fme_encoded,_writing_order,nombre_transaction,fme_pcre_match,"^fme_$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_2_8a9881fe_991f_4d2b_9441_4f1d6af0fd660_LIST_EXP)")         }
# -------------------------------------------------------------------------
# If we're doing LAST N features, then the multiplier comes in as 0.
# If we're doing First N, multiplier is -1.
# For RANDOM, we need to treat LAST N as if it was first N (i.e. have a -1)
# That is what the ? : does in the rate multiplier.
INCLUDE [ if { {1} == {0} && {ORIGINAL} == {ORIGINAL} } {              puts "MACRO REAL_MODE LAST"; 	         puts "MACRO REAL_RATE 5"; 	      } else {              puts "MACRO REAL_MODE ORIGINAL";              puts "MACRO REAL_RATE [expr 5 * ( 1 ? 1 : -1 ) ]"; 	      } ]
FACTORY_DEF {*} SamplingFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Sampler    COMMAND_PARM_EVALUATION SINGLE_PASS    SAMPLE_RATE $(REAL_RATE)    SAMPLE_ORDER $(REAL_MODE)    GROUP_BY { _writing_order }    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_2_OUTPUT"    OUTPUT SAMPLED FEATURE_TYPE ___SAMPLED___
# This TeeFactory is needed because Sampler will still output features if it has no OUTPUT clauses specified.
# This way we behave nicely even if there are no output connections on the transformer. See PR#28886.
FACTORY_DEF * TeeFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Sampler_Sampled    INPUT FEATURE_TYPE ___SAMPLED___    OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Sampler_SAMPLED"
# -------------------------------------------------------------------------
# Create the DomainName that this transformer will use.
# Because @Count itself will evalute the expression to calculate the
# domain, we don't need to do anything in Tcl per feature going by
INCLUDE [    set domainPrefix {};    if { {Local} == {Local} }    {       set domainPrefix [FME_EncodeText {$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_}];    };    puts "MACRO $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_FULL_DOMAIN ${domainPrefix}@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_writing_order<closeparen>,$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter)"; ]
FACTORY_DEF * ExecuteFunctionFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_Rejector    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Sampler_SAMPLED"    FUNCTION_DEFINITION @Count(REJECTABLE_WITH_FLAG,fme_encoded,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_FULL_DOMAIN),"1")    RESULT_ATTRIBUTE "_count"    FEATURE_TABLE_SHIM_SUPPORT Yes    OUTPUT COMPLETE FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_OUTPUT"    OUTPUT REJECTED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_<REJECTED>"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter <REJECTED> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_<REJECTED>"
