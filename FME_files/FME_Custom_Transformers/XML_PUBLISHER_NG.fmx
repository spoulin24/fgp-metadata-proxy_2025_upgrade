DEFAULT_MACRO __$(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_b37af224_51ef_4046_86b9_c73e75869e6b0_GROUP_BY
MACRO __$(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_b37af224_51ef_4046_86b9_c73e75869e6b0_GROUP_BY _writing_order
# If the cumulative port is connected, the _PORT_SPECIFIED macro
MACRO $(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_b37af224_51ef_4046_86b9_c73e75869e6b0_PORT_SPECIFIED no
# Force splitting of feature tables when the CUMULATIVE port is connected
MACRO $(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_b37af224_51ef_4046_86b9_c73e75869e6b0_SPLIT_FEATURE_TABLES Yes
INCLUDE [if { {$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_b37af224_51ef_4046_86b9_c73e75869e6b0_PORT_SPECIFIED)} == "no" } {     puts {MACRO $(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_b37af224_51ef_4046_86b9_c73e75869e6b0_SPLIT_FEATURE_TABLES No} }
DYNAMIC_FUNCTION_CONFIGURATION Python FMEOBJECTS
DYNAMIC_FUNCTION_CONFIGURATION Python import StatisticsCalculator
DYNAMIC_FUNCTION_CONFIGURATION Python "StatisticsCalculator.connectTransformer(    '$(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator',{     'GROUP_BY_MACRO':'__$(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_b37af224_51ef_4046_86b9_c73e75869e6b0_GROUP_BY',     'GROUP_BY':'_writing_order',     'STATS_ATTRS':'_writing_order',     'COUNT_ATTR':'nombre_transaction',     'COMPUTE_HISTOGRAM':'NO',     'HISTO_ATTR':'<Unused>',     'PREPEND_ATTR_NAME':'No',     'encoded_result_attrs':True,     'cumulative_mode':'$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_b37af224_51ef_4046_86b9_c73e75869e6b0_PORT_SPECIFIED)',     None:None})"
