FACTORY_DEF * TestFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2_OUTPUT"    TEST "@EvaluateExpression(FDIV,STRING_ENCODED,<at>UpperCase<openparen>$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_LOCAL_WRITER$encode)<closeparen>,$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester)" = YES ENCODED    BOOLEAN_OPERATOR OR    COMPOSITE_TEST_EXPR "1"    OUTPUT PASSED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_PASSED"    OUTPUT FAILED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_FAILED"
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_7    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_PASSED"    MULTI_FEATURE_MODE NO    NULL_ATTR_MODE NO_OP     ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV     ATTR_ACTION { "" "PyCSW_Transaction" "SET_TO" "Local" }    OUTPUT OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_7_OUTPUT"
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_7_OUTPUT"    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_FAILED"    OUTPUT FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_FILTER
FACTORY_DEF * AttributeFilterFactory FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_Filter COMMAND_PARM_EVALUATION SINGLE_PASS INPUT FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_FILTER FILTER_ATTRIBUTE PyCSW_Transaction FILTER_VALUES <lt>EMPTY<gt> <lt>MISSING<gt> <lt>NULL<gt> <lt>UNFILTERED<gt> Local Insert Update PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT OUTPUT <lt>EMPTY<gt> FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_<lt>EMPTY<gt> OUTPUT <lt>MISSING<gt> FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_<lt>MISSING<gt> OUTPUT <lt>NULL<gt> FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_<lt>NULL<gt> OUTPUT <lt>UNFILTERED<gt> FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_<lt>UNFILTERED<gt> OUTPUT Local FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_Local OUTPUT Insert FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_Insert OUTPUT Update FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_Update
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6 Update Splitter"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_Update"   OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_Update_0_gb6hF3XsvIU="   OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_Update_1_HcWrx5ILxzI="
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_11    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_6_Update_0_gb6hF3XsvIU="    MULTI_FEATURE_MODE NO    NULL_ATTR_MODE NO_OP     ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV     ATTR_ACTION { "" "where_clause" "SET_TO" "<space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><lt>ogc:PropertyIsEqualTo<gt><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><lt>ogc:PropertyName<gt>dc:identifier<lt><solidus>ogc:PropertyName<gt><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><lt>ogc:Literal<gt><at>Value<openparen>file_identifier<closeparen><lt><solidus>ogc:Literal<gt><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><lt><solidus>ogc:PropertyIsEqualTo<gt>" }      ATTR_ACTION { "" "_nb_element" "SET_TO" "1" }    OUTPUT OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_11_OUTPUT"
# -------------------------------------------------------------------------
# Create the DomainName that this transformer will use.
# Because @Count itself will evalute the expression to calculate the
# domain, we don't need to do anything in Tcl per feature going by
INCLUDE [    set domainPrefix {};    if { {Local} == {Local} }    {       set domainPrefix [FME_EncodeText {$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_2_}];    };    puts "MACRO $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_2_FULL_DOMAIN ${domainPrefix}counter"; ]
FACTORY_DEF * ExecuteFunctionFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_2_Rejector    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_11_OUTPUT"    FUNCTION_DEFINITION @Count(REJECTABLE_WITH_FLAG,fme_encoded,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_2_FULL_DOMAIN),"1")    RESULT_ATTRIBUTE "_nb_delete"    FEATURE_TABLE_SHIM_SUPPORT Yes    OUTPUT COMPLETE FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_2_OUTPUT"    OUTPUT REJECTED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_2_<REJECTED>"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_2 <REJECTED> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_2_<REJECTED>"
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_12    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Counter_2_OUTPUT"    MULTI_FEATURE_MODE NO    NULL_ATTR_MODE NO_OP     ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV     ATTR_ACTION { "" "_no_paquet" "SET_TO" "<at>Evaluate<openparen><at>floor<openparen><at>Value<openparen>_nb_delete<closeparen><solidus>10<closeparen><closeparen>" }    OUTPUT OUTPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_12_OUTPUT"
# -------------------------------------------------------------------------
FACTORY_DEF {*} AggregateFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Aggregator    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeCreator_12_OUTPUT"    MODE ONE_LEVEL    GROUP_BY { _no_paquet }    FLUSH_WHEN_GROUPS_CHANGE No    REMOVE_GEOMETRY NO    ACCUMULATE_ATTRIBUTES All    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE <Unused>    CONCATENATE_FIELDS { where_clause }    SUM_FIELDS { _nb_element }    PRODUCE_MULTIS YES    OUTPUT AGGREGATE FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Aggregator_AGGREGATE"
# -------------------------------------------------------------------------
FACTORY_DEF * TestFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_7    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Aggregator_AGGREGATE"    TEST "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_nb_element<closeparen>,$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_7)" != 1 ENCODED    BOOLEAN_OPERATOR OR    COMPOSITE_TEST_EXPR "1"    OUTPUT PASSED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_7_PASSED"    OUTPUT FAILED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_Tester_7_FAILED"
