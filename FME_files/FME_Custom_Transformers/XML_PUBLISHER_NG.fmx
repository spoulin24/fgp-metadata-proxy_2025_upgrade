FACTORY_DEF * ElementFactory    FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_SummaryExploder    LIST_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_StatisticsCalculator_stats{}    MODE LEAN_AND_MEAN    CLONE_GEOMETRY no    INPUT FEATURE_TYPE __UNUSED_INPUT_TO_GUARANTEE_FACTORY_DOESNT_CONSUME_EVERYTHING__
