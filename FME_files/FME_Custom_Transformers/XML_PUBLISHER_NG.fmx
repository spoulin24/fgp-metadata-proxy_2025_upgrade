FACTORY_DEF * XMLTemplaterFactory FACTORY_NAME $(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2 INPUT CONTROL_FEATURE FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeFilter_GMD_MDMETADATA" INPUT DATA_FEATURE FEATURE_TYPE $(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2_DataFeatures RESULT_ATTR _xml_raw OUTPUT_XML_HEADER NO GROUP_BY file_identifier CONSECUTIVE_GROUPS NO BUCKET_ATTR_NAME __xml_templater_bucket__ CONTROL_TEMPLATE_FILE "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_MDMETADATA$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" BUCKET_TEMPLATE_FILE GMD_CITEDRESPONSIBLEPARTY "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_CITEDRESPONSIBLEPARTY$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" BUCKET_TEMPLATE_FILE GMD_CONTACT "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_CONTACT$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" BUCKET_TEMPLATE_FILE GMD_DISTRIBUTIONFORMAT "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_DISTRIBUTIONFORMAT$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" BUCKET_TEMPLATE_FILE GMD_DISTRIBUTOR "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_DISTRIBUTOR$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" BUCKET_TEMPLATE_FILE GMD_KEYWORDS "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_KEYWORDS$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" BUCKET_TEMPLATE_FILE GMD_REFERENCESYSTEMINFO "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_REFERENCESYSTEMINFO$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" BUCKET_TEMPLATE_FILE GMD_RESOURCEMAINTENANCE "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_RESOURCEMAINTENANCE$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" BUCKET_TEMPLATE_FILE GMD_TOPICCATEGORY "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_TOPICCATEGORY$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" BUCKET_TEMPLATE_FILE GMD_TRANSFEROPTIONS "@EvaluateExpression(FDIV,STRING,$($(XML_PUBLISHER_NG_WORKSPACE_NAME)_TEMPLATE_GMD_TRANSFEROPTIONS$encode),$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2)" OUTPUT XML_DOCUMENT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLTemplater_2_OUTPUT"
