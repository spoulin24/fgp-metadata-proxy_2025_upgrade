INCLUDE [    if {{No} == {No}} {       puts {MACRO ERRORS_COUNT_CLAUSE ERRORS_COUNT_LIMIT -1};    }    else    {       puts {MACRO ERRORS_COUNT_CLAUSE ERRORS_COUNT_LIMIT <Unused>};    } ]
FACTORY_DEF {*} XMLValidationFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLValidator_2 }    INPUT INPUT FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLFormatter_2_PASSED"    MODE { SYNTAXONLY }    XML_TEXT_ATTR { "text_line_data" }    LIST_ATTR { _xml_error }    $(ERRORS_COUNT_CLAUSE)    OUTPUT { PASSED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLValidator_2_PASSED"        }    OUTPUT { FAILED FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLValidator_2_FAILED"        }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "_list<opencurly><closecurly>.FEATURE_ATTRIBUTES _list<opencurly><closecurly>.HNAP_ATTRIBUTES _list<opencurly><closecurly>.list_name"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_XMLValidator_2_PASSED"    OUTPUT { FEATURE_TYPE "$(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,_xml_data,_element_count,_list_index,_xml_data_header,METADATA_SECTION,_order,_RANDOM_list_name,_xml_raw,_RANDOM_HNAP_ATTRIBUTES,_RANDOM_FEATURE_ATTRIBUTES)        $($(XML_PUBLISHER_NG_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
