INCLUDE [ if { {Geometry Object} == {Geometry Object} } {            puts {MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_2_XML *} } ]
INCLUDE [ if { {Geometry Object} == {GeoJSON} } {            puts {MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_2_GEOJSON *} } ]
FACTORY_DEF {$($(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_2_XML)} CreationFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_2_XML_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______        @Geometry(FROM_ENCODED_STRING,<lt>?xml<space>version=<quote>1.0<quote><space>encoding=<quote>US_ASCII<quote><space>standalone=<quote>no<quote><space>?<gt><lt>geometry<gt><lt>null<solidus><gt><lt><solidus>geometry<gt>) }
FACTORY_DEF {$($(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_2_GEOJSON)} CreationFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_2_GEOJSON_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______ 	   @SupplyAttributes(ENCODED,__GeoJSONCreatorTemp__,<Unused>)        @JSONGeometry(FROM_ATTRIBUTE,GEOJSON,__GeoJSONCreatorTemp__, PREFER_ERROR_OVER_REJECTION) 	   @RemoveAttributes(__GeoJSONCreatorTemp__) }
