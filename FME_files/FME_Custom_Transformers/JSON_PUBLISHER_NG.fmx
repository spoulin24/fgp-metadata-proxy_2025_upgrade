FME_PYTHON_VERSION 37
DEFAULT_MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_JSON_ROOT_TEMPLATE 
DEFAULT_MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_JSON_RESOURCE_TEMPLATE 
DEFAULT_MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Keywords_EN 
DEFAULT_MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Keywords_FR 
DEFAULT_MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Topic_LIST 
DEFAULT_MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Subject_LIST 
DEFAULT_MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_FEATURE_TYPE 
DEFAULT_MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_IN_CSV_LOOKUP_TABLES_DIR 
DEFAULT_MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_P-T_ABBR 
#! START_HEADER
#! END_HEADER

DEFAULT_MACRO WB_CURRENT_CONTEXT
DEFAULT_MACRO JSON_PUBLISHER_NG_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(JSON_PUBLISHER_NG_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(JSON_PUBLISHER_NG_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_INPUT1657807722 Input Splitter"   INPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_INPUT"   OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_INPUT"
# -------------------------------------------------------------------------
Tcl2 proc $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CoordSysRemover {} {   global FME_CoordSys;   set FME_CoordSys {}; }
MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_XML     NOT_ACTIVATED
MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CLASSIC NOT_ACTIVATED
MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_2D3D    2D_GEOMETRY
MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_COORDS  <Unused>
INCLUDE [ if { {Geometry Object} == {Geometry Object} } {            puts {MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_XML *} } ]
INCLUDE [ if { {Geometry Object} == {2D Coordinate List} } {            puts {MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_2D3D 2D_GEOMETRY};            puts {MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CLASSIC *} } ]
INCLUDE [ if { {Geometry Object} == {3D Coordinate List} } {            puts {MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_2D3D 3D_GEOMETRY};            puts {MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CLASSIC *} } ]
