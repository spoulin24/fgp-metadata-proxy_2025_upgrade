FACTORY_DEF {*} StringReplacerFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_4 }    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_3_OUTPUT"    USE_REGEX { NO }    CASE_SENSITIVE { NO }    SOURCE_ATTRIBUTES { json_file }    FIND_TEXT { "<quote>FME_KEYWORDS_EN<quote>" }    REPLACE_TEXT { "@EvaluateExpression(FDIV,STRING_ENCODED,<openbracket><quote><at>Value<openparen>keywords_en<closeparen><quote><closebracket>,$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_4)" }    REPLACE_NO_MATCH { "_FME_NO_OP_" }    OUTPUT { OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_4_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} StringReplacerFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_6 }    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_4_OUTPUT"    USE_REGEX { NO }    CASE_SENSITIVE { NO }    SOURCE_ATTRIBUTES { json_file }    FIND_TEXT { "<quote>FME_SUBJECT_VALUES<quote>" }    REPLACE_TEXT { "@EvaluateExpression(FDIV,STRING_ENCODED,<openbracket><quote><at>Value<openparen>TBS_subject<closeparen><quote><closebracket>,$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_6)" }    REPLACE_NO_MATCH { "_FME_NO_OP_" }    OUTPUT { OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_6_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} StringReplacerFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_7 }    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_6_OUTPUT"    USE_REGEX { NO }    CASE_SENSITIVE { NO }    SOURCE_ATTRIBUTES { json_file }    FIND_TEXT { "<quote>FME_TOPIC_CATEGORY<quote>" }    REPLACE_TEXT { "@EvaluateExpression(FDIV,STRING_ENCODED,<openbracket><quote><at>Value<openparen>TBS_topic<closeparen><quote><closebracket>,$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_7)" }    REPLACE_NO_MATCH { "_FME_NO_OP_" }    OUTPUT { OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_7_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} StringReplacerFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer }    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_7_OUTPUT"    USE_REGEX { NO }    CASE_SENSITIVE { NO }    SOURCE_ATTRIBUTES { json_file }    FIND_TEXT { "<openbracket><quote><quote><closebracket>" }    REPLACE_TEXT { "<openbracket><space><closebracket>" }    REPLACE_NO_MATCH { "_FME_NO_OP_" }    OUTPUT { OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttributeKeeperFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_3 }    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_StringReplacer_OUTPUT"    KEEP_ATTRS { id,json_file }    KEEP_LISTS {  }    KEEP_FME_ATTRIBUTES Yes    BUILD_FEATURE_TABLES { NO }    OUTPUT_ON_ATTRIBUTE_CHANGE { <Unused> }    OUTPUT { OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_3_OUTPUT"        }
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Terminator }    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_FeatureMerger_2_UNMERGED_REQUESTOR"    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_FeatureMerger_2_UNUSED_SUPPLIER"    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_FeatureMerger_2_<REJECTED>"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"Translation<space>Terminated")       @SupplyAttributes(_wb_termination_xformer,"$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Terminator")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"Translation<space>Terminated") }
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Terminator_6 }    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_FeatureMerger_UNMERGED_REQUESTOR"    INPUT  FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_FeatureMerger_<REJECTED>"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"Translation<space>Terminated")       @SupplyAttributes(_wb_termination_xformer,"$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Terminator_6")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"Translation<space>Terminated") }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_OUTPUT_LOCAL1759778558 Output Collector"   INPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_AttributeKeeper_3_OUTPUT"   OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_OUTPUT_LOCAL"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(JSON_PUBLISHER_NG_WORKSPACE_NAME))}]
#! <?xml version="1.0" encoding="UTF-8" ?>
#! <TRANSFORMER
# TRANSFORMER_BEGIN JSON_PUBLISHER_NG,1,"FGP Tools",d7f83a94-b18a-45bd-98fb-bb48285d2d7f,"Linked by Default",No,NO_PARALLELISM,,No,20200,YES,No,37,No,
# <p><strong>Description </strong></p>
# <p>This custom transformer is translating the input CKAN metadata model into the JSON TBS model.  The rules on how to map the input CKAN features attributes into the TBS attributes are stored in the JSON configuration file. The JSON templates used to create the JSON file are supplied with the input parameters of the custom transformers.  The mapping into JSON file is done with FME JSON Templater transformer.</p>
# <p><strong>Input Ports</strong> </p>
# <ul>
# <li>Input: The input metadata records to translate into the JSON TBS model.</li>
# </ul>
# <p><strong>Output Ports</strong> </p>
# <ul>
# <li>OUTPUT_LOCAL: The output metdata records translated into the JSON TBS model.</li>
# </ul>
# <p><strong>Parameters</strong> </p>
# <ul>
# <li>JSON_ROOT_TEMPLATE: File system address containing the root section of the TBS model in JSON format.</li>
# <li>JSON_RESOURCE_TEMPLATE: File system address containing the resources section of the TBS model in JSON format.</li>
# </ul>
# TRANSFORMER_END
#!   ATTR_TYPE_ENCODING="SDF"
#!   BLOCKED_LOOPING="No"
#!   CATEGORY="FGP Tools"
#!   DESCRIPTION="&lt;p&gt;&lt;strong&gt;Description &lt;/strong&gt;&lt;/p&gt;&#10;&lt;p&gt;This custom transformer is translating the input CKAN metadata model into the JSON TBS model.  The rules on how to map the input CKAN features attributes into the TBS attributes are stored in the JSON configuration file. The JSON templates used to create the JSON file are supplied with the input parameters of the custom transformers.  The mapping into JSON file is done with FME JSON Templater transformer.&lt;/p&gt;&#10;&lt;p&gt;&lt;strong&gt;Input Ports&lt;/strong&gt; &lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;Input: The input metadata records to translate into the JSON TBS model.&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;&lt;strong&gt;Output Ports&lt;/strong&gt; &lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;OUTPUT_LOCAL: The output metdata records translated into the JSON TBS model.&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;&lt;strong&gt;Parameters&lt;/strong&gt; &lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;JSON_ROOT_TEMPLATE: File system address containing the root section of the TBS model in JSON format.&lt;/li&gt;&#10;&lt;li&gt;JSON_RESOURCE_TEMPLATE: File system address containing the resources section of the TBS model in JSON format.&lt;/li&gt;&#10;&lt;/ul&gt;"
