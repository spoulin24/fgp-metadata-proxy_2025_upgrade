slash><quote>contact_form<backslash><quote>:<space><backslash><quote>%s<backslash><quote><apos>%<openparen>feature.getAttribute<openparen><apos>contact_form_en<apos><closeparen><closeparen><lf><space><space><space><space>if<space><space>feature.getAttribute<openparen><apos>contact_form_fr<apos><closeparen>:<lf><space><space><space><space><space><space><space><space>contact_form_fr=r<apos><comma><backslash><quote>contact_form<backslash><quote>:<space><backslash><quote>%s<backslash><quote><apos>%<openparen>feature.getAttribute<openparen><apos>contact_form_fr<apos><closeparen><closeparen><lf><space><space><space><space><space><space><space><space><lf><space><space><space><space>remplacement=r<apos><quote><opencurly><backslash><quote>fr<backslash><quote>:<space><opencurly><backslash><quote>organization_name<backslash><quote>:<space><backslash><quote>%s<backslash><quote>%s%s<closecurly><comma><backslash><quote>en<backslash><quote>:<space><opencurly><backslash><quote>organization_name<backslash><quote>:<space><backslash><quote>%s<backslash><quote>%s%s<closecurly><closecurly><quote><apos>%<openparen>metadata_contact_fr<comma>email<comma>contact_form_fr<comma>metadata_contact_en<comma>email<comma>contact_form_en<closeparen><lf><space><space><space><space><lf><space><space><space><space>json_new=json_file.replace<openparen>r<apos><quote>FME_CONTACT_INFORMATION_VALUES<quote><apos><comma>remplacement<closeparen><lf><space><space><space><space>feature.setAttribute<openparen><apos>json_file<apos><comma>json_new<closeparen><lf><space><space><space><space><space><space><space><space><lf><space><space><space><space><space><lf><space><space><space><space><space><space><space><space><lf> }    PY_OUTPUT_TAGS { PYOUTPUT <Rejected> }    OUTPUT { PYOUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_PythonCaller_4_OUTPUT"         }    OUTPUT { <Rejected> FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_PythonCaller_4_<Rejected>"         }
