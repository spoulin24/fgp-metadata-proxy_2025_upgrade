pace><space><space><space><space><space><space><space><space><space><space><space>new_feature.setAttribute<openparen><apos>SECTION<apos><comma>keys<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>for<space>i<space>in<space>self.config<openbracket>keys<closebracket>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>new_att=i<openbracket><apos>TBS_ATTRIBUTES<apos><closebracket><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>new_values=feature.getAttribute<openparen>i<openbracket><apos>FEATURE_ATTRIBUTES<apos><closebracket><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>new_feature.setAttribute<openparen>new_att<comma>new_values<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>self.pyoutput<openparen>new_feature<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><lf><space><space><space><space>def<space>close<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>pass }    PY_OUTPUT_TAGS { PYOUTPUT <Rejected> }    OUTPUT { PYOUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_PythonCaller_2_OUTPUT"         }    OUTPUT { <Rejected> FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_PythonCaller_2_<Rejected>"         }
