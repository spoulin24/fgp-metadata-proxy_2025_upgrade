Tcl2 proc $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CoordSysRemover {} {   global FME_CoordSys;   set FME_CoordSys {}; }
MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_XML     NOT_ACTIVATED
MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_GEOJSON NOT_ACTIVATED
INCLUDE [ if { {Geometry Object} == {Geometry Object} } {            puts {MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_XML *} } ]
INCLUDE [ if { {Geometry Object} == {GeoJSON} } {            puts {MACRO $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_GEOJSON *} } ]
FACTORY_DEF {$($(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_XML)} CreationFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_XML_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______        @Geometry(FROM_ENCODED_STRING,<lt>?xml<space>version=<quote>1.0<quote><space>encoding=<quote>US_ASCII<quote><space>standalone=<quote>no<quote><space>?<gt><lt>geometry<gt><lt>null<solidus><gt><lt><solidus>geometry<gt>) }
FACTORY_DEF {$($(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_GEOJSON)} CreationFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_GEOJSON_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______ 	   @SupplyAttributes(ENCODED,__GeoJSONCreatorTemp__,<Unused>)        @JSONGeometry(FROM_ATTRIBUTE,GEOJSON,__GeoJSONCreatorTemp__, PREFER_ERROR_OVER_REJECTION) 	   @RemoveAttributes(__GeoJSONCreatorTemp__) }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_Cloner }    INPUT FEATURE_TYPE _____CREATED______        @Tcl2($(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CoordSysRemover)        @CoordSys()    NUMBER_OF_COPIES { 1 }    COPY_NUMBER_ATTRIBUTE { "_creation_instance" }    OUTPUT { FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED"        fme_feature_type $(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator CREATED Splitter"   INPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED"   OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED_0_kEwYpBZbFm4="   OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED_1_c0rHfXx0cCQ="   OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED_2_AU14bXVyULc="   OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED_3_oNuqy7vTXCk="   OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED_4_5J18jAbBE6A="   OUTPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED_5_cqTBJb9Odho="
FACTORY_DEF * BranchingFactory   FACTORY_NAME "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED_0_kEwYpBZbFm4= Brancher -1 60"   INPUT FEATURE_TYPE "$(JSON_PUBLISHER_NG_WORKSPACE_NAME)_Creator_CREATED_0_kEwYpBZbFm4="   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
