# -------------------------------------------------------------------------
Tcl2 proc $(UUID_4_FORMATTER_WORKSPACE_NAME)_StringConcatenator_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {id}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"<at>Value<openparen>id_substring_1<closeparen>-<at>Value<openparen>id_substring_2<closeparen>-<at>Value<openparen>id_substring_3<closeparen>-<at>Value<openparen>id_substring_4<closeparen>-<at>Value<openparen>id_substring_5<closeparen>"};    };    lappend parmList {$(UUID_4_FORMATTER_WORKSPACE_NAME)_StringConcatenator};    eval FME_Execute $parmList; }
FACTORY_DEF * TeeFactory    FACTORY_NAME $(UUID_4_FORMATTER_WORKSPACE_NAME)_StringConcatenator    INPUT  FEATURE_TYPE "$(UUID_4_FORMATTER_WORKSPACE_NAME)_SubstringExtractor_5_OUTPUT"    OUTPUT FEATURE_TYPE "$(UUID_4_FORMATTER_WORKSPACE_NAME)_StringConcatenator_OUTPUT"         @Tcl2("$(UUID_4_FORMATTER_WORKSPACE_NAME)_StringConcatenator_evaluator ")
# -------------------------------------------------------------------------
INCLUDE [    set macroLine "MACRO $(UUID_4_FORMATTER_WORKSPACE_NAME)_AttributeRemover_LIST_EXP ";    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append macroLine ",^$attr$";    };    puts $macroLine; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME $(UUID_4_FORMATTER_WORKSPACE_NAME)_AttributeRemover    INPUT  FEATURE_TYPE "$(UUID_4_FORMATTER_WORKSPACE_NAME)_StringConcatenator_OUTPUT"    OUTPUT { FEATURE_TYPE "$(UUID_4_FORMATTER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,id_substring_1,id_substring_5,id_substring_2,id_substring_3,id_substring_4)        @RemoveAttributes(fme_pcre_match"$($(UUID_4_FORMATTER_WORKSPACE_NAME)_AttributeRemover_LIST_EXP)")         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(UUID_4_FORMATTER_WORKSPACE_NAME)_OUTPUT1595953306 Output Collector"   INPUT FEATURE_TYPE "$(UUID_4_FORMATTER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(UUID_4_FORMATTER_WORKSPACE_NAME)_OUTPUT"
