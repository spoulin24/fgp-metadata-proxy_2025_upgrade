# -------------------------------------------------------------------------
# Since the Tcl "END" index specification starts at -1 for the second
# last character, and we've defined -1 to be the last charater, we've got
# small bit of fiddling to do
Tcl2 proc $(UUID_4_FORMATTER_WORKSPACE_NAME)_SubstringExtractor_fixLastIndex {lastValue} {     if {$lastValue < -1} {         incr lastValue;         return "end$lastValue";     }     elseif {$lastValue == -1} {         return "end";     }     else {         return $lastValue;     } }
Tcl2 proc $(UUID_4_FORMATTER_WORKSPACE_NAME)_SubstringExtractor_extract {startIdx endIdx} {     FME_SetAttribute [FME_DecodeText id_substring_1]         [string range [FME_DecodeTextOrAttr @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>id<closeparen>,$(UUID_4_FORMATTER_WORKSPACE_NAME)_SubstringExtractor)]                       [$(UUID_4_FORMATTER_WORKSPACE_NAME)_SubstringExtractor_fixLastIndex $startIdx]                       [$(UUID_4_FORMATTER_WORKSPACE_NAME)_SubstringExtractor_fixLastIndex $endIdx]]     }
FACTORY_DEF * TeeFactory    FACTORY_NAME $(UUID_4_FORMATTER_WORKSPACE_NAME)_SubstringExtractor    INPUT  FEATURE_TYPE "$(UUID_4_FORMATTER_WORKSPACE_NAME)_AttributeExposer_OUTPUT"    OUTPUT FEATURE_TYPE "$(UUID_4_FORMATTER_WORKSPACE_NAME)_SubstringExtractor_OUTPUT"         @Tcl2("$(UUID_4_FORMATTER_WORKSPACE_NAME)_SubstringExtractor_extract 0 7")
