FACTORY_DEF * TeeFactory   FACTORY_NAME "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_UNIQUE_ID_CREATOR_2 INPUT Input Collector"   INPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_StringReplacer_2_OUTPUT"   OUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_UNIQUE_ID_CREATOR_2_INPUT"
MACRO UNIQUE_ID_CREATOR_WORKSPACE_NAME $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_UNIQUE_ID_CREATOR_2
