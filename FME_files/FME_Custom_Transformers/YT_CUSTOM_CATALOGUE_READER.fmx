FACTORY_DEF {*} StringValueFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeSplitter_3 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"    FACTORY_MODE ATTRIBUTE_SPLITTER    ATTR_NAME { _list }       DELIMITER { <lt>tbody<gt> }       FIELD_QUALIFIER { "" }       TRIM_TYPE { BOTH }       LIST_NAME { _list }       DROP_EMPTY_PARTS { NO }    OUTPUT { OUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeSplitter_3_OUTPUT"          }
# -------------------------------------------------------------------------
Tcl2 proc $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_indexer {index numElements prefix suffix} {    if {$index < 0 } {       set index [expr $numElements + $index];    };    regsub \"{}\" {_list{}} \"{$index}\" listWithIndex;    regsub \"{}\" {_list{}} {} listBase;    set complexListExp "$listWithIndex\.";    set prefixLength [expr [string length $complexListExp]-1];    set prefix [FME_DecodeText $prefix];    set suffix [FME_DecodeText $suffix];    foreach attr [FME_AttributeNames] {      set newAttr {};      if {$attr == $listWithIndex} {        set newAttr $listBase;      } elseif {[string first $complexListExp $attr] == 0} {        set newAttr [string replace $attr 0 $prefixLength];      };      if {$newAttr != {}} {          if {$prefix != {} } {            set newAttr $prefix$newAttr;          };          if {$suffix != {} } {            set newAttr $newAttr$suffix;          };          if {[string first {fme_} $newAttr] != 0} {              set first [string first {fme_} $newAttr];              lappend attrsToCopy $newAttr $attr;          };      };    };    if {[info exists attrsToCopy] && [llength $attrsToCopy] > 0} {      eval FME_Execute CopyAttributes $attrsToCopy;    }; }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_IntTester }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeSplitter_3_OUTPUT"    TEST { "1" TYPE INT ENCODED }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { PASSED FEATURE_TYPE __toOutput__ }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_ListIndexer }    INPUT FEATURE_TYPE __toOutput__    TEST { "1" >= 0 }    OUTPUT PASSED FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_OUTPUT" @Tcl2("$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_indexer 1 0 {} {}")    OUTPUT FAILED FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_OUTPUT" @Tcl2("$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_indexer 1 @NumElements(_list{}) {} {}")
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3 OUTPUT Splitter"   INPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_OUTPUT"   OUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_OUTPUT_0_2krPhBSLypM="   OUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_3_OUTPUT_1_eQUuzUpi3bQ="
