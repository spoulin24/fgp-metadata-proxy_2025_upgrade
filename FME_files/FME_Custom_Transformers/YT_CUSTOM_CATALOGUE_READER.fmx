# -------------------------------------------------------------------------
# First determine which function we are going to be using -- we can do
# this statically at parse time for efficiency sake
MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr
MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function
MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr
MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr
INCLUDE [ set sourceText {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>extend<closeparen>,$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer)};           set decodedText [FME_DecodeText "$sourceText"];           if ![regexp {@EvaluateExpression\([^)]*STRING_ENCODED,@Value\(([^()]*)\),[^()]*\)} "$decodedText" dummy geomSrcAttr] {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr @SupplyAttributes(ENCODED,__GeometryReplacerTemp__,\"$sourceText\")";               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr @RemoveAttributes(__GeometryReplacerTemp__)";               set geomSrcAttr __GeometryReplacerTemp__;           } elseif {{Yes} == {Yes} } {                puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr @RemoveAttributes(\"$geomSrcAttr\")";           };           if {{wkt} == {fmebinary} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_BINARY,\"$geomSrcAttr\")";           } elseif {{wkt} == {fmehex} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_BINARY_HEX,\"$geomSrcAttr\")";           } elseif {{wkt} == {fmexml} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{wkt} == {fmexmlencoded} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ENCODED_STRING,&\"$geomSrcAttr\")";           } elseif {{wkt} == {polyline} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_POLYLINE,\"$geomSrcAttr\")";           } elseif {{wkt} == {wkt} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,wkt,\"$geomSrcAttr\",FLOAT_64)";           } elseif {{wkt} == {wkb} ||                      {wkt} == {wkbhex} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,wkt,\"$geomSrcAttr\")";           } elseif {{wkt} == {GEOJSON} ||                     {wkt} == {ESRIJSON} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @JSONGeometry(FROM_ATTRIBUTE,wkt,\"$geomSrcAttr\")";           } elseif {{wkt} == {GEORSS} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @GeoRSSGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{wkt} == {KML} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @KMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{wkt} == {GML} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @GMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{wkt} == {geohash} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @GeoHash(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{wkt} == {ogeosms} ||                     {wkt} == {geosms}  ||                     {wkt} == {geo} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,wkt,\"$geomSrcAttr\")";           } elseif {{wkt} == {mgrs}} {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @MGRS(FROM_MGRS, <Unused>, <Unused>,\"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>extend<closeparen>,$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer)\")"           } elseif {{wkt} == {mssql} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @SerializeGeometry(from_attribute,wkt,\"$geomSrcAttr\",<Unused>)";           } elseif {{wkt} == {iso6709} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @GeographicPoint(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{wkt} == {qlikmaps} } {               puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_QLIKMAPS_POLYLINE,\"$geomSrcAttr\")";           }; ]
FACTORY_DEF * TeeFactory    FACTORY_NAME $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_2_PASSED"    OUTPUT FEATURE_TYPE ___TOREJECTOR___         @RenameAttributes(FME_STRICT,___fme_rejection_code___,fme_rejection_code)         $($(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr)         $($(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Function)         $($(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr)
FACTORY_DEF * TestFactory    FACTORY_NAME $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_Rejector    INPUT FEATURE_TYPE ___TOREJECTOR___    TEST @Value(fme_rejection_code) != ""    OUTPUT PASSED FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_<REJECTED>"       @RemoveAttributes(___fme_rejection_code___)    OUTPUT FAILED FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_OUTPUT"       @RenameAttributes(FME_STRICT,fme_rejection_code,___fme_rejection_code___)       $($(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr)
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_4_LIST_FUNC }    } else {        puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_4_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_4    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_GeometryReplacer_<REJECTED>"    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_2_FAILED"    OUTPUT { FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_4_OUTPUT"        @RemoveAttributes(fme_encoded,extend)        $($(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_4_LIST_FUNC)         }
