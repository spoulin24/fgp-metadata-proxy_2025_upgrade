FME_PYTHON_PATH "$(FME_MF_DIR)"
FACTORY_DEF {*} PythonFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_PythonCaller }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListElementCounter_2_OUTPUT"    SYMBOL_NAME { FeatureProcessor }    SOURCE_CODE { import<space>fme<lf>import<space>fmeobjects<lf>#<space>Template<space>Function<space>interface:<lf>#<space>When<space>using<space>this<space>function<comma><space>make<space>sure<space>its<space>name<space>is<space>set<space>as<space>the<space>value<space>of<lf>#<space>the<space><apos>Class<space>or<space>Function<space>to<space>Process<space>Features<apos><space>transformer<space>parameter<lf>def<space>processFeature<openparen>feature<closeparen>:<lf><space><space><space><space>pass<lf><lf>#<space>Template<space>Class<space>Interface:<lf>#<space>When<space>using<space>this<space>class<comma><space>make<space>sure<space>its<space>name<space>is<space>set<space>as<space>the<space>value<space>of<lf>#<space>the<space><apos>Class<space>or<space>Function<space>to<space>Process<space>Features<apos><space>transformer<space>parameter<lf>class<space>FeatureProcessor<openparen>object<closeparen>:<lf><space><space><space><space>def<space>__init__<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>pass<lf><space><space><space><space>def<space>input<openparen>self<comma>feature<closeparen>:<lf><space><space><space><space><space><space><space><space>for<space>i<space>in<space>range<openparen>int<openparen>feature.getAttribute<openparen><apos>_element_count<apos><closeparen><closeparen><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space>feature.getAttribute<openparen><apos>resources<opencurly>%i<closecurly>.url<apos>%<openparen>i<closeparen><closeparen>.startswith<openparen>r<apos>https:<solidus><solidus>geoweb.gov.yk.ca<solidus>geoportal<solidus>rest<solidus>document?id=<apos><closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>resources<opencurly>%i<closecurly>.format<apos>%<openparen>i<closeparen><comma><apos>XML<apos><closeparen><lf><space><space><space><space><space><space><space><space><lf><space><space><space><space><space><space><space><space>self.pyoutput<openparen>feature<closeparen><lf><space><space><space><space>def<space>close<openparen>self<closeparen>:<lf><space><space><space><space><space><space><space><space>pass }    PY_OUTPUT_TAGS { PYOUTPUT <Rejected> }    OUTPUT { PYOUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_PythonCaller_OUTPUT"         }    OUTPUT { <Rejected> FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_PythonCaller_<Rejected>"         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_PythonCaller <Rejected> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_PythonCaller_<Rejected>"
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_4 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_PythonCaller_OUTPUT"    CASE_INSENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>author<closeparen>,$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_4)" NOT_CONTAINS Government<space>of<space>Canada ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_4_PASSED"         }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_5_LIST_FUNC }    } else {        puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_5_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_5 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_4_PASSED"    OUTPUT { FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_5_OUTPUT"        @RemoveAttributes(fme_encoded,_element_count,_element_index,_http_status_code,_response_body,_uuid_temp,_zmax,_zmin)        $($(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_5_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeExposer_17 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_5_OUTPUT"    OUTPUT { FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeExposer_17_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListElementCounter_3 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeExposer_17_OUTPUT"    OUTPUT { FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListElementCounter_3_OUTPUT"         @SupplyAttributes(ENCODED, _element_count, @NumElements("resources<opencurly><closecurly>",ENCODED))          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_5 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListElementCounter_3_OUTPUT"    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_element_count<closeparen>,$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_5)" != 0 ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_5_PASSED"         }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_6_LIST_FUNC }    } else {        puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_6_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_6 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Tester_5_PASSED"    OUTPUT { FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_6_OUTPUT"        @RemoveAttributes(fme_encoded,_element_count)        $($(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_6_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER Input Input Collector"   INPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_6_OUTPUT"   OUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_Input"
MACRO ATTRIBUTE_UNEXPOSER_WORKSPACE_NAME $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER
MACRO $(ATTRIBUTE_UNEXPOSER_WORKSPACE_NAME)_TRANSFORMER_GROUP 
MACRO $(ATTRIBUTE_UNEXPOSER_WORKSPACE_NAME)_XFORMER_NAME $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER
INCLUDE_CUSTOM_TRANSFORMER_VER ATTRIBUTE_UNEXPOSER:2
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER Output Output Renamer/Nuker"   INPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_Output"   OUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_Output"
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Terminator_2 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_FeatureMerger_UNUSED_SUPPLIER"    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_FeatureMerger_<REJECTED>"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"Translation<space>Terminated")       @SupplyAttributes(_wb_termination_xformer,"$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_Terminator_2")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"Translation<space>Terminated") }
