# -------------------------------------------------------------------------
Tcl2 proc $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_indexer {index numElements prefix suffix} {    if {$index < 0 } {       set index [expr $numElements + $index];    };    regsub \"{}\" {_list{}} \"{$index}\" listWithIndex;    regsub \"{}\" {_list{}} {} listBase;    set complexListExp "$listWithIndex\.";    set prefixLength [expr [string length $complexListExp]-1];    set prefix [FME_DecodeText $prefix];    set suffix [FME_DecodeText $suffix];    foreach attr [FME_AttributeNames] {      set newAttr {};      if {$attr == $listWithIndex} {        set newAttr $listBase;      } elseif {[string first $complexListExp $attr] == 0} {        set newAttr [string replace $attr 0 $prefixLength];      };      if {$newAttr != {}} {          if {$prefix != {} } {            set newAttr $prefix$newAttr;          };          if {$suffix != {} } {            set newAttr $newAttr$suffix;          };          if {[string first {fme_} $newAttr] != 0} {              set first [string first {fme_} $newAttr];              lappend attrsToCopy $newAttr $attr;          };      };    };    if {[info exists attrsToCopy] && [llength $attrsToCopy] > 0} {      eval FME_Execute CopyAttributes $attrsToCopy;    }; }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_IntTester }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeSplitter_OUTPUT"    TEST { "1" TYPE INT ENCODED }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { PASSED FEATURE_TYPE __toOutput__ }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_ListIndexer }    INPUT FEATURE_TYPE __toOutput__    TEST { "1" >= 0 }    OUTPUT PASSED FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_OUTPUT" @Tcl2("$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_indexer 1 0 {} {}")    OUTPUT FAILED FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_OUTPUT" @Tcl2("$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_indexer 1 @NumElements(_list{}) {} {}")
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer OUTPUT Splitter"   INPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_OUTPUT"   OUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_OUTPUT_0_ucanc+ASC1o="   OUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_OUTPUT_1_7fVW/BiP800="
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "_list<opencurly><closecurly>"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_ListIndexer_OUTPUT_0_ucanc+ASC1o="    OUTPUT { FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,)        $($(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
# -------------------------------------------------------------------------
