FACTORY_DEF {*} StringReplacerFactory    FACTORY_NAME { $(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_StringReplacer_2 }    INPUT  FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"    USE_REGEX { NO }    CASE_SENSITIVE { NO }    SOURCE_ATTRIBUTES { orig_name }    FIND_TEXT { "data<solidus>datasets<solidus>" }    REPLACE_TEXT { "" }    REPLACE_NO_MATCH { "_FME_NO_OP_" }    OUTPUT { OUTPUT FEATURE_TYPE "$(YT_CUSTOM_CATALOGUE_READER_WORKSPACE_NAME)_StringReplacer_2_OUTPUT"          }
