FME_PYTHON_PATH "$(FME_MF_DIR)"
FACTORY_DEF {*} PythonFactory    FACTORY_NAME { $(BC_WMS_FORMATTER_WORKSPACE_NAME)_PythonCaller }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT  FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeExposer_2_OUTPUT"    SYMBOL_NAME { processFeature }    SOURCE_CODE { import<space>fme<lf>import<space>fmeobjects<lf>#<space>Template<space>Function<space>interface:<lf>#<space>When<space>using<space>this<space>function<comma><space>make<space>sure<space>its<space>name<space>is<space>set<space>as<space>the<space>value<space>of<lf>#<space>the<space><apos>Class<space>or<space>Function<space>to<space>Process<space>Features<apos><space>transformer<space>parameter<lf>def<space>processFeature<openparen>feature<closeparen>:<lf><space><space><space><space>index=0<lf><space><space><space><space>for<space>url<space>in<space>feature.getAttribute<openparen><apos>resources<opencurly><closecurly>.url<apos><closeparen>:<lf><lf><space><space><space><space><space><space><space><space>if<space>r<apos>service=WMS<amp>request=GetCapabilities<apos><space>in<space>url:<lf><lf><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>resources<opencurly>%s<closecurly>.url<apos>%<openparen>str<openparen>index<closeparen><closeparen><comma>r<apos>%s<amp>layers=pub:%s<amp>legend_format=image<solidus>png<amp>feature_info_type=text<solidus>plain<apos>%<openparen>url<comma>feature.getAttribute<openparen><apos>object_name<apos><closeparen><closeparen><closeparen><lf><space><space><space><space><space><space><space><space>index=index+1<lf><space><space><space><space><lf><space><space><space><space><lf><space><space><space><space><lf><lf> }    PY_OUTPUT_TAGS { PYOUTPUT <Rejected> }    OUTPUT { PYOUTPUT FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_PythonCaller_OUTPUT"         }    OUTPUT { <Rejected> FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_PythonCaller_<Rejected>"         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_PythonCaller <Rejected> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_PythonCaller_<Rejected>"
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_PythonCaller_OUTPUT"    OUTPUT { FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,object_name)        $($(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_OUTPUT1759777154 Output Collector"   INPUT FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_OUTPUT"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(BC_WMS_FORMATTER_WORKSPACE_NAME))}]
