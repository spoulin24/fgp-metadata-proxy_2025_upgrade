FACTORY_DEF * TeeFactory    FACTORY_NAME $(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeExposer_2    INPUT  FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_INPUT"    OUTPUT FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeExposer_2_OUTPUT"
# -------------------------------------------------------------------------
FME_PYTHON_PATH "$(FME_MF_DIR)"
FACTORY_DEF * PythonFactory    FACTORY_NAME $(BC_WMS_FORMATTER_WORKSPACE_NAME)_PythonCaller    INPUT  FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeExposer_2_OUTPUT"    SYMBOL_NAME processFeature    PYTHON_NAMESPACE FMEOBJECTS    SOURCE_CODE import<space>fme<lf>import<space>fmeobjects<lf>#<space>Template<space>Function<space>interface:<lf>#<space>When<space>using<space>this<space>function<comma><space>make<space>sure<space>its<space>name<space>is<space>set<space>as<space>the<space>value<space>of<lf>#<space>the<space><apos>Class<space>or<space>Function<space>to<space>Process<space>Features<apos><space>transformer<space>parameter<lf>def<space>processFeature<openparen>feature<closeparen>:<lf><space><space><space><space>index=0<lf><space><space><space><space>for<space>url<space>in<space>feature.getAttribute<openparen><apos>resources<opencurly><closecurly>.url<apos><closeparen>:<lf><lf><space><space><space><space><space><space><space><space>if<space>r<apos>service=WMS<amp>request=GetCapabilities<apos><space>in<space>url:<lf><lf><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>resources<opencurly>%s<closecurly>.url<apos>%<openparen>str<openparen>index<closeparen><closeparen><comma>r<apos>%s<amp>layers=pub:%s<amp>legend_format=image<solidus>png<amp>feature_info_type=text<solidus>plain<apos>%<openparen>url<comma>feature.getAttribute<openparen><apos>object_name<apos><closeparen><closeparen><closeparen><lf><space><space><space><space><space><space><space><space>index=index+1<lf><space><space><space><space><lf><space><space><space><space><lf><space><space><space><space><lf><lf>    OUTPUT PYOUTPUT FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_PythonCaller_OUTPUT"
# -------------------------------------------------------------------------
INCLUDE [    set macroLine "MACRO $(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover_LIST_EXP ";    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append macroLine ",^$attr$";    };    puts $macroLine; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME $(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover    INPUT  FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_PythonCaller_OUTPUT"    OUTPUT { FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,object_name)        @RemoveAttributes(fme_pcre_match"$($(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover_LIST_EXP)")         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_OUTPUT1582302268 Output Collector"   INPUT FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(BC_WMS_FORMATTER_WORKSPACE_NAME)_OUTPUT"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(BC_WMS_FORMATTER_WORKSPACE_NAME))}]
