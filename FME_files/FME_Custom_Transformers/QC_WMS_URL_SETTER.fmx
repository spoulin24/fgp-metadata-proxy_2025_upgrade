INCLUDE [if { {ATTRIBUTES} == {ATTRIBUTES} } {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO ATTRIBUTES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_AND_ATTR_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_AND_ATTR_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} } {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} } {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          else {}; ]
FACTORY_DEF {*} ReferenceFactory    FACTORY_NAME $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3    FLUSH_WHEN_GROUPS_CHANGE No    INPUT REFERENCER FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_OUTPUT"    INPUT REFERENCEE FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_MERGED"    INPUT REFERENCEE FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_4_MERGED"    INPUT REFERENCEE FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_Tester_8_FAILED"    REFERENCE_INFO $($(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_REFERENCE_INFO)    REFERENCE_TABLE @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>uuid_wms<closeparen>,$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3) @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>uuid_wms<closeparen>,$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3) AUTO    ATTR_ACCUM_MODE "HANDLE_CONFLICT"    ATTR_CONFLICT_RES "REQUESTOR_IF_CONFLICT"    IGNORE_NULLS "No"    HANDLE_NULL_MISSING_KEYS_LIKE_FME2013 No    LIST_NAME "resources"    LIST_ATTRS_TO_INCLUDE { format name orig_id url format_resourceType_en format_resourceType_fr }    LIST_ATTRS_TO_INCLUDE_MODE SELECTED    MERGE_ATTRIBUTES Yes    MANAGE_FME_TYPE Yes    MODE COMPLETE    PROCESS_DUPLICATE_REFERENCEES NO    REFERENCEES_FIRST No    REJECT_INVALID_GEOM YES    CLEANING_TOLERANCE <Unused>    OUTPUT COMPLETE FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_MERGED"
# -------------------------------------------------------------------------
INCLUDE [    set macroLine "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_3_LIST_EXP ";    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append macroLine ",^$attr$";    };    puts $macroLine; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_3    INPUT  FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_3_MERGED"    OUTPUT { FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"        @RemoveAttributes(fme_encoded,uuid_wms)        @RemoveAttributes(fme_pcre_match"$($(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_3_LIST_EXP)")         }
