FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_Tester_8 }    INPUT  FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeKeeper_2_OUTPUT"    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>format<closeparen>,$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_Tester_8)" = WMS ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_Tester_8_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_Tester_8_FAILED"         }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_Tester_8_PASSED"    OUTPUT { FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,url)        $($(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} SortFactory    FACTORY_NAME { $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_Sorter }    INPUT  FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"    SORT_ALPHA_AS_UTF8 { YES }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    SORT_BY { orig_id ALPHA ASCENDING NON_VALUES_BEFORE_VALUES name ALPHA ASCENDING NON_VALUES_BEFORE_VALUES }    OUTPUT { SORTED FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_Sorter_SORTED"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} DuplicateRemoverFactory    FACTORY_NAME { $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_DuplicateFilter }    COMMAND_PARM_EVALUATION SINGLE_PASS    SUPPORTS_FEATURE_TABLES    INPUT  FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_Sorter_SORTED"    KEY_ATTRIBUTES { orig_id }    INPUT_IS_ORDERED { NO }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { DUPLICATE FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_DuplicateFilter_DUPLICATE"         }    OUTPUT { UNIQUE FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_DuplicateFilter_UNIQUE"         }
# -------------------------------------------------------------------------
INCLUDE [if { {ATTRIBUTES} == {ATTRIBUTES} } {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO ATTRIBUTES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {POLYGONS}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_AND_ATTR_BUILD_POLYS";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {AGGREGATES}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} && {<Unused>} == {LINESFROMPOINTS}} {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_AND_ATTR_BUILD_LINES_FROM_POINTS";             }          elseif { {ATTRIBUTES} == {GEOM_BUILD} } {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_BUILD_AGGREGATES";             }          elseif { {ATTRIBUTES} == {GEOM_AND_ATTRS} } {                puts "MACRO $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO GEOM_AND_ATTR_BUILD_AGGREGATES";             }          else {}; ]
FACTORY_DEF {*} ReferenceFactory    FACTORY_NAME { $(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT REFERENCER FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_DuplicateFilter_UNIQUE"    INPUT REFERENCEE FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_AttributeExposer_9_OUTPUT_0_F0g/YdqA4O4="    REFERENCE_INFO { $($(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_REFERENCE_INFO) }    REFERENCE_TABLE { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>orig_id<closeparen>,$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger) @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>id<closeparen>,$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger) AUTO }    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "REQUESTOR_IF_CONFLICT" }    IGNORE_NULLS { "No" }    HANDLE_NULL_MISSING_KEYS_LIKE_FME2013 { No }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    MERGE_ATTRIBUTES Yes    MANAGE_FME_TYPE Yes    MODE COMPLETE    PROCESS_DUPLICATE_REFERENCEES { NO }    REFERENCEES_FIRST { No }    REJECT_INVALID_GEOM YES    CLEANING_TOLERANCE { <Unused> }    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    COMPARE_WHITESPACE Yes    OUTPUT { COMPLETE FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_MERGED"         }    OUTPUT { REJECTED FEATURE_TYPE "$(QC_WMS_URL_SETTER_WORKSPACE_NAME)_FeatureMerger_<REJECTED>"         }
# -------------------------------------------------------------------------
