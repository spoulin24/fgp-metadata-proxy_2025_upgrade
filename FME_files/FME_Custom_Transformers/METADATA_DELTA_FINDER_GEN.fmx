FACTORY_DEF {*} TestFactory FACTORY_NAME { $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_TestFilter_3 } INPUT FEATURE_TYPE $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_TestFilter_3_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_METADATA_TYPE$encode),$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_TestFilter_3) = XML-HNAP ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_TestFilter_3_XML-HNAP TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_METADATA_TYPE$encode),$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_TestFilter_3) = JSON-CKANExtCa ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_1 FEATURE_TYPE $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_TestFilter_3_JSON_CKANExtCa OUTPUT FAILED FEATURE_TYPE $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_TestFilter_3_<lt>UNFILTERED<gt>
