MACRO $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_FeatureReader_OUTPUT_PORTS_ENCODED 
MACRO $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_FeatureReader_DIRECTIVES RETRIEVE_FILE_PROPERTIES,NO,RECURSE_DIRECTORIES,NO,TYPE,ANY,GLOB_PATTERN,*,NO_EMPTY_PROPERTIES,YES
# Always provide an INTERACTION, otherwise the factory defaults to ENVELOPE_INTERSECTS
INCLUDE [if { ( {<Unused>} == {<Unused>} ) || ( {($INTERACT_OPTIONS)} == {} ) } {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION NONE};          } else {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION "<Unused>"};          }         ]
# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_FeatureReader_COMBINE_ATTRS
