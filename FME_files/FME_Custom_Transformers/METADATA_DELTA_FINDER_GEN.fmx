FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Terminator_5 }    INPUT  FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Tester_3_FAILED"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"Translation<space>Terminated.<space>More<space>than<space>75%<space>of<space>metadata<space>are<space>inserted.<space>Verify<space>if<space>it<space>is<space>ok<comma><space>then<space>change<space>Validate_insert<space>to<space><apos>No<apos><space>if<space>ok.")       @SupplyAttributes(_wb_termination_xformer,"$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Terminator_5")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"Translation<space>Terminated.<space>More<space>than<space>75%<space>of<space>metadata<space>are<space>inserted.<space>Verify<space>if<space>it<space>is<space>ok<comma><space>then<space>change<space>Validate_insert<space>to<space><apos>No<apos><space>if<space>ok.") }
# -------------------------------------------------------------------------
# The default behaviour is to abort on any feature entering the transformer.
# If Workbench has set the _WB_BYPASS_TERMINATION macro to a value of "Yes",
# then the features will instead be passed through with a feature type of
# __WB_BYPASS_TERMINATOR__, which Workbench will send to a visualizer or
# somesuch.
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Terminator_11 }    INPUT  FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Tester_6_FAILED"    TEST { "$(_WB_BYPASS_TERMINATION)" == Yes }    OUTPUT { PASSED FEATURE_TYPE __WB_BYPASS_TERMINATOR__       @SupplyAttributes(_wb_termination_feature_type,@FeatureType())       @SupplyAttributes(ENCODED,_wb_termination_message,"@EvaluateExpression(FDIV,STRING_ENCODED,Translation<space>Terminated:<space><at>Value<openparen>error<closeparen>,$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Terminator_11)")       @SupplyAttributes(_wb_termination_xformer,"$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Terminator_11")       @SupplyAttributes(_wb_termination_feature,Yes) }    OUTPUT { FAILED FEATURE_TYPE * @Abort(ENCODED,"@EvaluateExpression(FDIV,STRING_ENCODED,Translation<space>Terminated:<space><at>Value<openparen>error<closeparen>,$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Terminator_11)") }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Update1759843102 Output Collector"   INPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_5_Output"   OUTPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Update"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Insert1759843102 Output Collector"   INPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_6_Output"   OUTPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Insert"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Delete1759843102 Output Collector"   INPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_ATTRIBUTE_UNEXPOSER_7_Output"   OUTPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Delete"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Statistics1759843102 Output Collector"   INPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_AttributeCreator_4_OUTPUT"   OUTPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_Statistics"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_No_Change1759843102 Output Collector"   INPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_TestFilter_4_No<space>Overwrite_1_E5pIiSxdVNw="   OUTPUT FEATURE_TYPE "$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME)_No_Change"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(METADATA_DELTA_FINDER_GEN_WORKSPACE_NAME))}]
#! <?xml version="1.0" encoding="UTF-8" ?>
#! <TRANSFORMER
# TRANSFORMER_BEGIN METADATA_DELTA_FINDER_GEN,1,"FGP Tools",1e6f6659-5cfc-4f86-9653-d71b81509d29,"Linked by Default",No,NO_PARALLELISM,,No,20787,YES,No,37,No,
# <p><strong>Description</strong> </p>
# <p>This custom transformer identify the type of transaction (insert, update, delete, no change) for each metadata records read from the province.  In order to determine the type of transaction, the metadata reference records (from the PYCSW or from a Local Source) are read and are compared using a hash function (see note) with the records from the province (new records). There are four possible types of transaction:</p>
# <ul>
# <li>
# <p>Insert: A record read from the province is not found in the reference records (PYCSW or Local Source)</p>
# </li>
# <li>
# <p>Update: A record read from the province is found in the reference records (PYCSW or Local Source) but with one or more differences in the content of the metadata record</p>
# </li>
# <li>
# <p>Delete: A record is present in the reference record (PYCSW or Local Source) but not in the province</p>
# </li>
# <li>
# <p>No change: A record read from the province is identical (all fields are the same) to a record found in the reference records (PYCSW or Local Source).</p>
# </li>
# </ul>
# <p><strong>Input Ports </strong></p>
# <ul>
# <li>Input: The input metadata records from the province.</li>
# </ul>
# <p><strong>Output Ports</strong> </p>
# <ul>
# <li>
# <p>Statistics: The number of unchanged features to pass to the <em>Logger Parameters</em> transformers;</p>
# </li>
# <li>
# <p>No Change: Features that were not modified in regards with the content of the referenced records (PYCSW or Local Source);</p>
# </li>
# <li>
# <p>Update: Features that were updated (modified feature) in regards with the content of the referenced records (PYCSW or Local Source);</p>
# </li>
# <li>
# <p>Insert: Features to insert (new feature) in regards to the content of the referenced records (PYCSW or Local Source);</p>
# </li>
# <li>
# <p>Delete: Features to delete (feature removed) in regards to the content of the referenced records (PYCSW or Local Source).</p>
# </li>
# </ul>
# <p>Note: If the parameter <em>METADATA_OVERWRITE</em> is set to <em>YES</em>, all the unchanged features are flag as Insert.</p>
# <p><strong>Parameters </strong></p>
# <ul>
# <li>ABSTRACT_ATT_NEW: Name of the attribute containing the description of the abstract for the new record from the province</li>
# <li>
# <p>ABSTRACT_ATT_REF: Name of the attribute containing the description of the abstract for the reference record (PYCSW or Local source)</p>
# </li>
# <li>
# <p>DATESTAMP_ATT_NEW: Name of the attribute containing the date stamp for the new record from the province</p>
# </li>
# <li>
# <p>DATESTAMP_ATT_REF: Name of the attribute containing the date stamp for the reference record (PYCSW or Local source)</p>
# </li>
# <li>
# <p>ID_ATT_NEW: Name of the attribute containing the identification for the new record from the province</p>
# </li>
# <li>
# <p>ID_ATT_REF: Name of the attribute containing the identification for the reference record (PYCSW or Local Source)</p>
# </li>
# <li>
# <p>RES_NAME_ATT_NEW: Name of the attribute containing the resource name for the new record from the province</p>
# </li>
# <li>
# <p>RES_NAME_ATT_REF: Name of the attribute containing the resource name for the reference record (PYCSW or Local Source)</p>
# </li>
# <li>
# <p>RES_URL_ATT_NEW: Name of the attribute containing the resource URL for the new record from the province</p>
# </li>
# <li>
# <p>RES_URL_ATT_REF: Name of the attribute containing the resource URL for the reference record (PYCSW or Local Source)</p>
# </li>
# <li>
# <p>TITLE_ATT_NEW: Name of the attribute containing the title for the new record from the province</p>
# </li>
# <li>
# <p>TITLE_ATT_REF: Name of the attribute containing the title for the reference record (PYCSW or Local Source)</p>
# </li>
# <li>
# <p>CUSTOM_CSW_CKAN_URL: Name of the attribute containing the URL of the PYCSW server</p>
# </li>
# <li>
# <p>CKAN_FILTER: Name of the attribute used to filter CKAN records in the PyCSW server</p>
# </li>
# <li>
# <p>LOCAL_SOURCE: Flag indicating if the metadata record for identifying the action (insert, update, delete, no change) must be read from the PYCSW server or are stored on the local system. Can take 2 values: YES: read the records from the PYCSW; NO read the records from the Local source.</p>
# </li>
# <li>
# <p>LOCAL_SOURCE_FORMAT: Flag indicating the type of metadata format format to process.  Can take 2 values: XML to process XML format records (geospatial data); JSON to process JSON format records (non geospatial data)</p>
# </li>
# <li>
# <p>LOCAL_SOURCE_DIR: Name of the directory containing the local source of the referenced records. Used if LOCAL_SOURCE parameters is set to NO</p>
# </li>
# <li>
# <p>CSW_FILTER: Name of the attribute used to filter CSW records in the PyCSW server in order to select records from one province only</p>
# </li>
# <li>
# <p>RES_FORMAT_ATT_NEW: Name of the attribute containing the format of the resource for the new record from the province</p>
# </li>
# <li>
# <p>RES_FORMAT_ATT_REF: Name of the attribute containing the format of the resource for the reference record (PYCSW or Local Source)</p>
# </li>
# <li>
# <p>METADATA_OVERWRITE: Flag indicating to overwrite or not the metadata. Can take 2 values: <em>YES</em>: Overwrite the content of the PyCSW server; <em>NO</em>: Do not overwrite the content of the PyCSW server; </p>
# </li>
# </ul>
# <p><strong>Note:</strong></p>
# <p>A hash function using strategic attributes is used to determine if 2 metadata records (features) are the same.</p>
# TRANSFORMER_END
#!   ATTR_TYPE_ENCODING="SDF"
#!   BLOCKED_LOOPING="No"
#!   CATEGORY="FGP Tools"
#!   DESCRIPTION="&lt;p&gt;&lt;strong&gt;Description&lt;/strong&gt; &lt;/p&gt;&#10;&lt;p&gt;This custom transformer identify the type of transaction (insert, update, delete, no change) for each metadata records read from the province.  In order to determine the type of transaction, the metadata reference records (from the PYCSW or from a Local Source) are read and are compared using a hash function (see note) with the records from the province (new records). There are four possible types of transaction:&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Insert: A record read from the province is not found in the reference records (PYCSW or Local Source)&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Update: A record read from the province is found in the reference records (PYCSW or Local Source) but with one or more differences in the content of the metadata record&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Delete: A record is present in the reference record (PYCSW or Local Source) but not in the province&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;No change: A record read from the province is identical (all fields are the same) to a record found in the reference records (PYCSW or Local Source).&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;&lt;strong&gt;Input Ports &lt;/strong&gt;&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;Input: The input metadata records from the province.&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;&lt;strong&gt;Output Ports&lt;/strong&gt; &lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Statistics: The number of unchanged features to pass to the &lt;em&gt;Logger Parameters&lt;/em&gt; transformers;&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;No Change: Features that were not modified in regards with the content of the referenced records (PYCSW or Local Source);&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Update: Features that were updated (modified feature) in regards with the content of the referenced records (PYCSW or Local Source);&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Insert: Features to insert (new feature) in regards to the content of the referenced records (PYCSW or Local Source);&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;Delete: Features to delete (feature removed) in regards to the content of the referenced records (PYCSW or Local Source).&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;Note: If the parameter &lt;em&gt;METADATA_OVERWRITE&lt;/em&gt; is set to &lt;em&gt;YES&lt;/em&gt;, all the unchanged features are flag as Insert.&lt;/p&gt;&#10;&lt;p&gt;&lt;strong&gt;Parameters &lt;/strong&gt;&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;ABSTRACT_ATT_NEW: Name of the attribute containing the description of the abstract for the new record from the province&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;ABSTRACT_ATT_REF: Name of the attribute containing the description of the abstract for the reference record (PYCSW or Local source)&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;DATESTAMP_ATT_NEW: Name of the attribute containing the date stamp for the new record from the province&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;DATESTAMP_ATT_REF: Name of the attribute containing the date stamp for the reference record (PYCSW or Local source)&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;ID_ATT_NEW: Name of the attribute containing the identification for the new record from the province&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;ID_ATT_REF: Name of the attribute containing the identification for the reference record (PYCSW or Local Source)&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;RES_NAME_ATT_NEW: Name of the attribute containing the resource name for the new record from the province&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;RES_NAME_ATT_REF: Name of the attribute containing the resource name for the reference record (PYCSW or Local Source)&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;RES_URL_ATT_NEW: Name of the attribute containing the resource URL for the new record from the province&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;RES_URL_ATT_REF: Name of the attribute containing the resource URL for the reference record (PYCSW or Local Source)&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;TITLE_ATT_NEW: Name of the attribute containing the title for the new record from the province&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;TITLE_ATT_REF: Name of the attribute containing the title for the reference record (PYCSW or Local Source)&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;CUSTOM_CSW_CKAN_URL: Name of the attribute containing the URL of the PYCSW server&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;CKAN_FILTER: Name of the attribute used to filter CKAN records in the PyCSW server&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;LOCAL_SOURCE: Flag indicating if the metadata record for identifying the action (insert, update, delete, no change) must be read from the PYCSW server or are stored on the local system. Can take 2 values: YES: read the records from the PYCSW; NO read the records from the Local source.&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;LOCAL_SOURCE_FORMAT: Flag indicating the type of metadata format format to process.  Can take 2 values: XML to process XML format records (geospatial data); JSON to process JSON format records (non geospatial data)&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;LOCAL_SOURCE_DIR: Name of the directory containing the local source of the referenced records. Used if LOCAL_SOURCE parameters is set to NO&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;CSW_FILTER: Name of the attribute used to filter CSW records in the PyCSW server in order to select records from one province only&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;RES_FORMAT_ATT_NEW: Name of the attribute containing the format of the resource for the new record from the province&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;RES_FORMAT_ATT_REF: Name of the attribute containing the format of the resource for the reference record (PYCSW or Local Source)&lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;li&gt;&#10;&lt;p&gt;METADATA_OVERWRITE: Flag indicating to overwrite or not the metadata. Can take 2 values: &lt;em&gt;YES&lt;/em&gt;: Overwrite the content of the PyCSW server; &lt;em&gt;NO&lt;/em&gt;: Do not overwrite the content of the PyCSW server; &lt;/p&gt;&#10;&lt;/li&gt;&#10;&lt;/ul&gt;&#10;&lt;p&gt;&lt;strong&gt;Note:&lt;/strong&gt;&lt;/p&gt;&#10;&lt;p&gt;A hash function using strategic attributes is used to determine if 2 metadata records (features) are the same.&lt;/p&gt;"
