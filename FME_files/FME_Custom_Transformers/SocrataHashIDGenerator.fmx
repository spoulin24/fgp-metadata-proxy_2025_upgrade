FME_PYTHON_VERSION 37
#! START_HEADER
#! END_HEADER

DEFAULT_MACRO WB_CURRENT_CONTEXT
DEFAULT_MACRO SocrataHashIDGenerator_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(SocrataHashIDGenerator_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(SocrataHashIDGenerator_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(SocrataHashIDGenerator_WORKSPACE_NAME)_feature_input1607047190 Input Splitter"   INPUT FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_feature_input"   OUTPUT FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_feature_input"
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory    FACTORY_NAME $(SocrataHashIDGenerator_WORKSPACE_NAME)_AttributeExposer    INPUT  FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_feature_input"    OUTPUT FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_AttributeExposer_OUTPUT"
# -------------------------------------------------------------------------
FACTORY_DEF * TestFactory    FACTORY_NAME $(SocrataHashIDGenerator_WORKSPACE_NAME)_Tester    INPUT  FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_AttributeExposer_OUTPUT"    TEST resource.id ATTRIBUTE_HAS_A_VALUE "" ENCODED TEST resource.id NOT_ATTRIBUTE_VALUE_NULL "" ENCODED TEST resource.id NOT_ATTRIBUTE_IS_EMPTY "" ENCODED TEST resource.id NOT_ATTRIBUTE_IS_MISSING "" ENCODED    BOOLEAN_OPERATOR AND    COMPOSITE_TEST_EXPR "1 AND 2 AND 3 AND 4"    OUTPUT PASSED FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_Tester_PASSED"    OUTPUT FAILED FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_Tester_FAILED"
# -------------------------------------------------------------------------
FME_PYTHON_PATH "$(FME_MF_DIR)"
FACTORY_DEF * PythonFactory    FACTORY_NAME $(SocrataHashIDGenerator_WORKSPACE_NAME)_PythonCaller_2    INPUT  FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_Tester_PASSED"    SYMBOL_NAME processFeature    PYTHON_NAMESPACE FMEOBJECTS    SOURCE_CODE import<space>fme<lf>import<space>fmeobjects<lf>import<space>uuid<lf>#<space>Template<space>Function<space>interface:<lf>#<space>When<space>using<space>this<space>function<comma><space>make<space>sure<space>its<space>name<space>is<space>set<space>as<space>the<space>value<space>of<lf>#<space>the<space><apos>Class<space>or<space>Function<space>to<space>Process<space>Features<apos><space>transformer<space>parameter<lf>def<space>processFeature<openparen>feature<closeparen>:<lf><space><space><space><space><space><space><space><space>SocrataID<space>=<space>feature.getAttribute<openparen><apos>resource.id<apos><closeparen><lf><space><space><space><space><space><space><space><space>feature_uuid<space>=<space>uuid.uuid5<openparen>uuid.NAMESPACE_X500<comma>SocrataID<closeparen><lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>id<apos><comma>str<openparen>feature_uuid<closeparen><closeparen><lf><space><space><space><space><space><space><space><space><lf>    OUTPUT PYOUTPUT FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_PythonCaller_2_OUTPUT"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(SocrataHashIDGenerator_WORKSPACE_NAME)_feature_output1607047190 Output Collector"   INPUT FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_PythonCaller_2_OUTPUT"   OUTPUT FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_feature_output"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(SocrataHashIDGenerator_WORKSPACE_NAME)_invalid_or_missing_id1607047190 Output Collector"   INPUT FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_Tester_FAILED"   OUTPUT FEATURE_TYPE "$(SocrataHashIDGenerator_WORKSPACE_NAME)_invalid_or_missing_id"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(SocrataHashIDGenerator_WORKSPACE_NAME))}]
